 "voice": "af_heart",
 "speed": 0.97,
 "buildCount": 5,
 "sentences": [
  {
   "i": 0,
   "start": 0.15,
   "speechStart": 0.15,
   "end": 5.15,
   "builds": 0,
   "text": "At night you can’t see shapes or numbers, so the lights have to carry the message."
  },
  {
   "i": 1,
   "start": 5.4,
   "speechStart": 5.4,
   "end": 7.2,
   "builds": 1,
   "text": "The rule is simple."
  },
  {
   "i": 2,
   "start": 7.45,
   "speechStart": 7.45,
   "end": 9.625,
   "builds": 0,
   "text": "Red marks show red lights."
  },
  {
   "i": 3,
   "start": 9.875,
   "speechStart": 9.875,
   "end": 12.05,
   "builds": 0,
   "text": "Green marks show green lights."
  },
  {
   "i": 4,
   "start": 12.3,
   "speechStart": 12.3,
   "end": 16.5,
   "builds": 1,
   "text": "The rhythm can be flashing, occulting, quick, or isophase."
  },
  {
   "i": 5,
   "start": 16.75,
   "speechStart": 16.75,
   "end": 19.65,
   "builds": 1,
   "text": "A quick-flashing light means pay attention."
  },
  {
   "i": 6,
   "start": 19.9,
   "speechStart": 19.9,
   "end": 25.35,
   "builds": 0,
   "text": "It usually marks a sharp turn, a junction, or a spot that needs special caution."
  },
  {
   "i": 7,
   "start": 25.6,
   "speechStart": 25.6,
   "end": 28.825,
   "builds": 1,
   "text": "Lighted buoys usually aren’t nun or can shaped."
  },
  {
   "i": 8,
   "start": 29.075,
   "speechStart": 29.075,
   "end": 31.175,
   "builds": 0,
   "text": "They’re pillars or spars."
  },
  {
   "i": 9,
   "start": 31.425,
   "speechStart": 31.425,
   "end": 34.325,
   "builds": 0,
   "text": "So how do you tell red from green in daylight?"
  },
  {
   "i": 10,
   "start": 34.575,
   "speechStart": 35.325,
   "end": 37.875,
   "builds": 0,
   "text": "By color and number, not shape."
  },
  {
   "i": 11,
   "start": 38.125,
   "speechStart": 38.125,
   "end": 48.0,
   "builds": 1,
   "text": "And a preferred channel mark, where a channel splits, shows a special rhythm: composite group flashing, two flashes and then one, in the color of its top band."
  },
  {
   "i": 12,
   "start": 48.25,
   "speechStart": 48.25,
   "end": 49.975,
   "builds": 0,
   "text": "One more tip."
  },
  {
   "i": 13,
   "start": 50.225,
   "speechStart": 50.225,
   "end": 54.05,
   "builds": 0,
   "text": "Unlighted buoys carry reflective tape in their own color."
  },
  {
   "i": 14,
   "start": 54.3,
   "speechStart": 54.3,
   "end": 56.45,
   "builds": 0,
   "text": "A spotlight will pick them out."
  }
 ]
}
