 "voice": "af_heart",
 "speed": 0.97,
 "buildCount": 5,
 "sentences": [
  {
   "i": 0,
   "start": 0.15,
   "speechStart": 0.15,
   "end": 6.8,
   "builds": 0,
   "text": "The engine compartment fire is the most dangerous one on a small boat, and your instinct will be wrong."
  },
  {
   "i": 1,
   "start": 7.05,
   "speechStart": 7.05,
   "end": 10.2,
   "builds": 0,
   "text": "Your instinct says: open the hatch and look."
  },
  {
   "i": 2,
   "start": 10.45,
   "speechStart": 10.45,
   "end": 11.85,
   "builds": 0,
   "text": "Don’t."
  },
  {
   "i": 3,
   "start": 12.1,
   "speechStart": 12.1,
   "end": 13.775,
   "builds": 0,
   "text": "Here’s the drill."
  },
  {
   "i": 4,
   "start": 14.025,
   "speechStart": 14.025,
   "end": 19.275,
   "builds": 1,
   "text": "Shut down the engines, the generator and the blowers, and close the fuel valves."
  },
  {
   "i": 5,
   "start": 19.525,
   "speechStart": 19.525,
   "end": 23.175,
   "builds": 1,
   "text": "Close the vents and hatches to starve the fire of air."
  },
  {
   "i": 6,
   "start": 23.425,
   "speechStart": 23.425,
   "end": 25.375,
   "builds": 1,
   "text": "And leave the hatch shut."
  },
  {
   "i": 7,
   "start": 25.625,
   "speechStart": 25.625,
   "end": 27.75,
   "builds": 0,
   "text": "What happens if you open it?"
  },
  {
   "i": 8,
   "start": 28.0,
   "speechStart": 28.75,
   "end": 32.625,
   "builds": 0,
   "text": "A rush of fresh air, and the fire flares up in your face."
  },
  {
   "i": 9,
   "start": 32.875,
   "speechStart": 32.875,
   "end": 37.05,
   "builds": 1,
   "text": "Discharge the fixed system, if it hasn’t gone off by itself."
  },
  {
   "i": 10,
   "start": 37.3,
   "speechStart": 37.3,
   "end": 41.05,
   "builds": 0,
   "text": "Many systems shut the engines down when they fire."
  },
  {
   "i": 11,
   "start": 41.3,
   "speechStart": 41.3,
   "end": 42.85,
   "builds": 1,
   "text": "Then wait."
  },
  {
   "i": 12,
   "start": 43.1,
   "speechStart": 43.1,
   "end": 49.5,
   "builds": 0,
   "text": "At least fifteen minutes before you open that compartment, so it can cool and the fire can’t reignite."
  },
  {
   "i": 13,
   "start": 49.75,
   "speechStart": 49.75,
   "end": 53.975,
   "builds": 0,
   "text": "And when you do open it, have a portable extinguisher in your hand."
  }
 ]
}
