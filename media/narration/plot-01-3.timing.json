  {
   "i": 0,
   "start": 0.15,
   "speechStart": 0.15,
   "end": 4.375,
   "builds": 0,
   "text": "Now the compass rose itself, which holds more than it seems to."
  },
  {
   "i": 1,
   "start": 4.625,
   "speechStart": 4.625,
   "end": 8.875,
   "builds": 1,
   "text": "The outer ring shows true directions, with zero at true north."
  },
  {
   "i": 2,
   "start": 9.125,
   "speechStart": 9.125,
   "end": 12.225,
   "builds": 1,
   "text": "The inner ring shows magnetic directions."
  },
  {
   "i": 3,
   "start": 12.475,
   "speechStart": 12.475,
   "end": 16.5,
   "builds": 0,
   "text": "It’s the same circle, twisted by the local variation."
  },
  {
   "i": 4,
   "start": 16.75,
   "speechStart": 16.75,
   "end": 22.45,
   "builds": 1,
   "text": "In the center, it tells you the variation, the year it was measured, and the annual change."
  },
  {
   "i": 5,
   "start": 22.7,
   "speechStart": 22.7,
   "end": 27.75,
   "builds": 1,
   "text": "Use the rose nearest your work, because variation changes across the chart."
  },
  {
   "i": 6,
   "start": 28.0,
   "speechStart": 28.0,
   "end": 30.1,
   "builds": 1,
   "text": "So which ring should you use?"
  },
  {
   "i": 7,
   "start": 30.35,
   "speechStart": 30.35,
   "end": 32.525,
   "builds": 0,
   "text": "The inner ring looks tempting."
  },
  {
   "i": 8,
   "start": 32.775,
   "speechStart": 32.775,
   "end": 35.675,
   "builds": 0,
   "text": "It gives you magnetic with no arithmetic."
  },
  {
   "i": 9,
   "start": 35.925,
   "speechStart": 35.925,
   "end": 37.6,
   "builds": 0,
   "text": "What’s the catch?"
  },
  {
   "i": 10,
   "start": 37.85,
   "speechStart": 38.6,
   "end": 41.1,
   "builds": 0,
   "text": "The rose may be years out of date."
  },
  {
   "i": 11,
   "start": 41.35,
   "speechStart": 41.35,
   "end": 47.725,
   "builds": 0,
   "text": "So most captains, and most exam problems, work in true on the outer ring, and convert at the end."
  }
 ]
