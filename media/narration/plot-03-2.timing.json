 "sentences": [
  {
   "i": 0,
   "start": 0.15,
   "speechStart": 0.15,
   "end": 6.05,
   "builds": 0,
   "text": "Laying a course is the most common thing you’ll do on the plotting exam, so let’s make it a routine."
  },
  {
   "i": 1,
   "start": 6.3,
   "speechStart": 6.3,
   "end": 10.425,
   "builds": 1,
   "text": "Draw a straight line from your departure point to your destination."
  },
  {
   "i": 2,
   "start": 10.675,
   "speechStart": 10.675,
   "end": 12.325,
   "builds": 0,
   "text": "And look along it."
  },
  {
   "i": 3,
   "start": 12.575,
   "speechStart": 12.575,
   "end": 15.0,
   "builds": 0,
   "text": "Does it cross land, or a shoal?"
  },
  {
   "i": 4,
   "start": 15.25,
   "speechStart": 15.25,
   "end": 20.75,
   "builds": 1,
   "text": "Walk the parallel rulers to the nearest rose, and read the true course on the outer ring."
  },
  {
   "i": 5,
   "start": 21.0,
   "speechStart": 21.0,
   "end": 25.625,
   "builds": 1,
   "text": "Measure the length of the line with your dividers on the latitude scale."
  },
  {
   "i": 6,
   "start": 25.875,
   "speechStart": 25.875,
   "end": 29.45,
   "builds": 1,
   "text": "What if the leg is longer than your dividers will open?"
  },
  {
   "i": 7,
   "start": 29.7,
   "speechStart": 30.45,
   "end": 34.875,
   "builds": 0,
   "text": "Set them to a round number, say five miles, on the side scale."
  },
  {
   "i": 8,
   "start": 35.125,
   "speechStart": 35.125,
   "end": 40.1,
   "builds": 0,
   "text": "Step them along the line, count the steps, and then measure the leftover piece."
  },
  {
   "i": 9,
   "start": 40.35,
   "speechStart": 40.35,
   "end": 42.325,
   "builds": 1,
   "text": "Finally, label it."
  },
  {
   "i": 10,
   "start": 42.575,
   "speechStart": 42.575,
   "end": 44.825,
   "builds": 0,
   "text": "Course above, speed below."
  },
  {
   "i": 11,
   "start": 45.075,
   "speechStart": 45.075,
   "end": 48.675,
   "builds": 0,
   "text": "And write your estimated time of arrival at the far end."
  }
 ]
}
