 "buildCount": 0,
 "sentences": [
  {
   "i": 0,
   "start": 0.15,
   "speechStart": 0.15,
   "end": 2.825,
   "builds": 0,
   "text": "Welcome to Navigation General."
  },
  {
   "i": 1,
   "start": 3.075,
   "speechStart": 3.075,
   "end": 7.275,
   "builds": 0,
   "text": "This module answers three questions a captain asks all day."
  },
  {
   "i": 2,
   "start": 7.525,
   "speechStart": 7.525,
   "end": 9.125,
   "builds": 0,
   "text": "Where am I?"
  },
  {
   "i": 3,
   "start": 9.375,
   "speechStart": 9.375,
   "end": 11.35,
   "builds": 0,
   "text": "What’s the water doing?"
  },
  {
   "i": 4,
   "start": 11.6,
   "speechStart": 11.6,
   "end": 13.95,
   "builds": 0,
   "text": "And what’s the weather about to do?"
  },
  {
   "i": 5,
   "start": 14.2,
   "speechStart": 14.2,
   "end": 23.125,
   "builds": 0,
   "text": "It covers more ground than any other part of the exam, so we’ll take it one piece at a time, and we start with the most basic piece: position."
  },
  {
   "i": 6,
   "start": 23.375,
   "speechStart": 23.375,
   "end": 25.2,
   "builds": 0,
   "text": "Look at the diagram."
  },
  {
   "i": 7,
   "start": 25.45,
   "speechStart": 25.45,
   "end": 31.875,
   "builds": 0,
   "text": "Latitude measures how far north or south of the equator you are, from zero to ninety degrees."
  },
  {
   "i": 8,
   "start": 32.125,
   "speechStart": 32.125,
   "end": 39.775,
   "builds": 0,
   "text": "Longitude measures how far east or west you are of the prime meridian at Greenwich, from zero to one hundred eighty."
  },
  {
   "i": 9,
   "start": 40.025,
   "speechStart": 40.025,
   "end": 43.025,
   "builds": 0,
   "text": "Each degree divides into sixty minutes."
  },
  {
   "i": 10,
   "start": 43.275,
   "speechStart": 43.275,
   "end": 49.1,
   "builds": 0,
   "text": "On the chart, latitude is read on the side scales, and longitude on the top and bottom."
  },
  {
   "i": 11,
   "start": 49.35,
   "speechStart": 49.35,
   "end": 51.35,
   "builds": 0,
   "text": "So which do you write first?"
  },
  {
   "i": 12,
   "start": 51.6,
   "speechStart": 52.35,
   "end": 54.0,
   "builds": 0,
   "text": "Latitude."
  },
  {
   "i": 13,
   "start": 54.25,
   "speechStart": 54.25,
   "end": 55.75,
   "builds": 0,
   "text": "Always."
  },
  {
   "i": 14,
   "start": 56.0,
   "speechStart": 56.0,
   "end": 58.075,
   "builds": 0,
   "text": "And here’s an easy check."
  },
  {
   "i": 15,
   "start": 58.325,
   "speechStart": 58.325,
   "end": 62.4,
   "builds": 0,
   "text": "All of Florida is north latitude and west longitude."
  },
  {
   "i": 16,
   "start": 62.65,
   "speechStart": 62.65,
   "end": 65.75,
   "builds": 0,
   "text": "If your answer says east, something went wrong."
  }
 ]
}
