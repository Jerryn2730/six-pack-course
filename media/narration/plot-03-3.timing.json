 "sentences": [
  {
   "i": 0,
   "start": 0.15,
   "speechStart": 0.15,
   "end": 4.725,
   "builds": 0,
   "text": "Distance looks easy, and that’s exactly why it costs people points."
  },
  {
   "i": 1,
   "start": 4.975,
   "speechStart": 4.975,
   "end": 10.15,
   "builds": 1,
   "text": "One minute of latitude is one nautical mile, measured at the side of the chart."
  },
  {
   "i": 2,
   "start": 10.4,
   "speechStart": 10.4,
   "end": 13.8,
   "builds": 1,
   "text": "Use the part of the scale that’s level with your work."
  },
  {
   "i": 3,
   "start": 14.05,
   "speechStart": 14.05,
   "end": 16.6,
   "builds": 1,
   "text": "Never use the longitude scale."
  },
  {
   "i": 4,
   "start": 16.85,
   "speechStart": 16.85,
   "end": 20.15,
   "builds": 0,
   "text": "At New England’s latitude, how wrong would that be?"
  },
  {
   "i": 5,
   "start": 20.4,
   "speechStart": 21.15,
   "end": 23.05,
   "builds": 0,
   "text": "About a quarter too long."
  },
  {
   "i": 6,
   "start": 23.3,
   "speechStart": 23.3,
   "end": 27.675,
   "builds": 0,
   "text": "And that wrong answer will be sitting among the choices, waiting for you."
  },
  {
   "i": 7,
   "start": 27.925,
   "speechStart": 27.925,
   "end": 30.1,
   "builds": 1,
   "text": "Step your dividers carefully."
  },
  {
   "i": 8,
   "start": 30.35,
   "speechStart": 30.35,
   "end": 34.15,
   "builds": 0,
   "text": "On a long leg, a small slip at every step adds up."
  },
  {
   "i": 9,
   "start": 34.4,
   "speechStart": 34.4,
   "end": 37.625,
   "builds": 1,
   "text": "And give distances to the nearest tenth of a mile."
  },
  {
   "i": 10,
   "start": 37.875,
   "speechStart": 37.875,
   "end": 43.525,
   "builds": 0,
   "text": "The answer choices are often only two tenths apart, so this is not the place to round."
  }
 ]
}
