 "sentences": [
  {
   "i": 0,
   "start": 0.15,
   "speechStart": 0.15,
   "end": 5.825,
   "builds": 0,
   "text": "Every Florida captain eventually meets a day that turned out worse than the forecast."
  },
  {
   "i": 1,
   "start": 6.075,
   "speechStart": 6.075,
   "end": 8.525,
   "builds": 0,
   "text": "This lesson is about that day."
  },
  {
   "i": 2,
   "start": 8.775,
   "speechStart": 8.775,
   "end": 12.35,
   "builds": 1,
   "text": "The best heavy-weather tactic is not to be out in it."
  },
  {
   "i": 3,
   "start": 12.6,
   "speechStart": 12.6,
   "end": 15.725,
   "builds": 0,
   "text": "Check the forecast, and when in doubt, don’t go."
  },
  {
   "i": 4,
   "start": 15.975,
   "speechStart": 15.975,
   "end": 19.3,
   "builds": 0,
   "text": "No fish is worth it, and neither is a refund."
  },
  {
   "i": 5,
   "start": 19.55,
   "speechStart": 19.55,
   "end": 23.85,
   "builds": 1,
   "text": "If the weather catches you anyway, life jackets go on everyone."
  },
  {
   "i": 6,
   "start": 24.1,
   "speechStart": 24.1,
   "end": 26.3,
   "builds": 0,
   "text": "Before it’s rough, not during."
  },
  {
   "i": 7,
   "start": 26.55,
   "speechStart": 26.55,
   "end": 30.1,
   "builds": 1,
   "text": "Secure the loose gear, and close the hatches and doors."
  },
  {
   "i": 8,
   "start": 30.35,
   "speechStart": 30.35,
   "end": 31.95,
   "builds": 1,
   "text": "Slow down."
  },
  {
   "i": 9,
   "start": 32.2,
   "speechStart": 32.2,
   "end": 36.4,
   "builds": 0,
   "text": "Pounding into head seas at speed hurts people and breaks boats."
  },
  {
   "i": 10,
   "start": 36.65,
   "speechStart": 36.65,
   "end": 38.5,
   "builds": 0,
   "text": "So how do you take them?"
  },
  {
   "i": 11,
   "start": 38.75,
   "speechStart": 39.5,
   "end": 44.95,
   "builds": 0,
   "text": "At a slight angle off the bow, at a speed that lets her ride up and over each wave."
  },
  {
   "i": 12,
   "start": 45.2,
   "speechStart": 45.2,
   "end": 49.475,
   "builds": 1,
   "text": "And keep your passengers seated, low, and near the middle of the boat."
  },
  {
   "i": 13,
   "start": 49.725,
   "speechStart": 49.725,
   "end": 52.0,
   "builds": 0,
   "text": "That’s where the motion is least."
  }
 ]
}
