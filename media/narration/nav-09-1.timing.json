 "voice": "af_heart",
 "speed": 0.97,
 "buildCount": 5,
 "sentences": [
  {
   "i": 0,
   "start": 0.15,
   "speechStart": 0.15,
   "end": 3.2,
   "builds": 0,
   "text": "Every screen on your boat needs electricity."
  },
  {
   "i": 1,
   "start": 3.45,
   "speechStart": 3.45,
   "end": 8.625,
   "builds": 0,
   "text": "One instrument doesn’t, and it’s the one that will get you home when the rest go dark."
  },
  {
   "i": 2,
   "start": 8.875,
   "speechStart": 8.875,
   "end": 10.875,
   "builds": 0,
   "text": "The magnetic compass."
  },
  {
   "i": 3,
   "start": 11.125,
   "speechStart": 11.125,
   "end": 12.7,
   "builds": 1,
   "text": "It’s simple."
  },
  {
   "i": 4,
   "start": 12.95,
   "speechStart": 12.95,
   "end": 19.0,
   "builds": 0,
   "text": "A magnetized card floats in liquid, and it lines itself up with the earth’s magnetic field."
  },
  {
   "i": 5,
   "start": 19.25,
   "speechStart": 19.25,
   "end": 21.125,
   "builds": 0,
   "text": "The card stays still."
  },
  {
   "i": 6,
   "start": 21.375,
   "speechStart": 21.375,
   "end": 23.275,
   "builds": 0,
   "text": "The boat turns around it."
  },
  {
   "i": 7,
   "start": 23.525,
   "speechStart": 23.525,
   "end": 28.025,
   "builds": 1,
   "text": "The lubber line is a mark on the bowl, lined up with the boat’s centerline."
  },
  {
   "i": 8,
   "start": 28.275,
   "speechStart": 28.275,
   "end": 31.925,
   "builds": 0,
   "text": "Your heading is the number on the card at the lubber line."
  },
  {
   "i": 9,
   "start": 32.175,
   "speechStart": 32.175,
   "end": 38.35,
   "builds": 1,
   "text": "So the compass must be mounted on the centerline, or parallel to it, where the helmsman can see it."
  },
  {
   "i": 10,
   "start": 38.6,
   "speechStart": 38.6,
   "end": 42.15,
   "builds": 1,
   "text": "Keep magnetic and electrical things away from it."
  },
  {
   "i": 11,
   "start": 42.4,
   "speechStart": 42.4,
   "end": 45.2,
   "builds": 0,
   "text": "Speakers, radios, phones, tools."
  },
  {
   "i": 12,
   "start": 45.45,
   "speechStart": 45.45,
   "end": 48.1,
   "builds": 0,
   "text": "Even a cup holder with a magnet in it."
  },
  {
   "i": 13,
   "start": 48.35,
   "speechStart": 48.35,
   "end": 50.625,
   "builds": 0,
   "text": "Why does that matter so much?"
  },
  {
   "i": 14,
   "start": 50.875,
   "speechStart": 51.625,
   "end": 57.025,
   "builds": 0,
   "text": "Because moving any of them changes the compass’s error, and you won’t know by how much."
  },
  {
   "i": 15,
   "start": 57.275,
   "speechStart": 57.275,
   "end": 60.725,
   "builds": 1,
   "text": "And the gimbals keep the card level as the boat rolls."
  }
 ]
}
