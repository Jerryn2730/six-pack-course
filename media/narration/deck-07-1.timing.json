 "voice": "af_heart",
 "speed": 0.97,
 "buildCount": 0,
 "sentences": [
  {
   "i": 0,
   "start": 0.15,
   "speechStart": 0.15,
   "end": 7.675,
   "builds": 0,
   "text": "Nothing shows a captain’s skill like the last fifty feet to the dock, with six passengers and a full marina watching."
  },
  {
   "i": 1,
   "start": 7.925,
   "speechStart": 7.925,
   "end": 12.0,
   "builds": 0,
   "text": "Today is about why a boat moves the way she does at low speed."
  },
  {
   "i": 2,
   "start": 12.25,
   "speechStart": 12.25,
   "end": 15.6,
   "builds": 0,
   "text": "Start with something most new captains never notice."
  },
  {
   "i": 3,
   "start": 15.85,
   "speechStart": 15.85,
   "end": 18.75,
   "builds": 0,
   "text": "A propeller doesn’t only push the boat ahead."
  },
  {
   "i": 4,
   "start": 19.0,
   "speechStart": 19.0,
   "end": 21.6,
   "builds": 0,
   "text": "It also shoves the stern sideways."
  },
  {
   "i": 5,
   "start": 21.85,
   "speechStart": 21.85,
   "end": 23.775,
   "builds": 0,
   "text": "That’s propeller walk."
  },
  {
   "i": 6,
   "start": 24.025,
   "speechStart": 24.025,
   "end": 25.85,
   "builds": 0,
   "text": "Look at the diagram."
  },
  {
   "i": 7,
   "start": 26.1,
   "speechStart": 26.1,
   "end": 32.425,
   "builds": 0,
   "text": "On a single-screw boat with a right-hand propeller, the stern kicks slightly to starboard going ahead."
  },
  {
   "i": 8,
   "start": 32.675,
   "speechStart": 32.675,
   "end": 35.625,
   "builds": 0,
   "text": "In reverse, it walks strongly to port."
  },
  {
   "i": 9,
   "start": 35.875,
   "speechStart": 35.875,
   "end": 37.65,
   "builds": 0,
   "text": "So think it through."
  },
  {
   "i": 10,
   "start": 37.9,
   "speechStart": 37.9,
   "end": 42.425,
   "builds": 0,
   "text": "You’re coming in to stop alongside, and you give her a burst of reverse."
  },
  {
   "i": 11,
   "start": 42.675,
   "speechStart": 42.675,
   "end": 45.4,
   "builds": 0,
   "text": "Which side would you rather have the dock on?"
  },
  {
   "i": 12,
   "start": 45.65,
   "speechStart": 46.4,
   "end": 48.05,
   "builds": 0,
   "text": "The port side."
  },
  {
   "i": 13,
   "start": 48.3,
   "speechStart": 48.3,
   "end": 54.05,
   "builds": 0,
   "text": "That burst of reverse stops the boat and pulls your stern in toward the dock at the same time."
  },
  {
   "i": 14,
   "start": 54.3,
   "speechStart": 54.3,
   "end": 57.7,
   "builds": 0,
   "text": "Find out which way your boat walks before you need to know."
  }
 ]
}
