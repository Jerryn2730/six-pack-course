   "builds": 0,
   "text": "Let’s work one from start to finish."
  },
  {
   "i": 1,
   "start": 3.0,
   "speechStart": 3.0,
   "end": 4.875,
   "builds": 0,
   "text": "Follow it on screen."
  },
  {
   "i": 2,
   "start": 5.125,
   "speechStart": 5.125,
   "end": 10.5,
   "builds": 1,
   "text": "The reference station says: high water at ten forty-two, three point six feet."
  },
  {
   "i": 3,
   "start": 10.75,
   "speechStart": 10.75,
   "end": 14.65,
   "builds": 0,
   "text": "Low water at sixteen fifty, zero point four feet."
  },
  {
   "i": 4,
   "start": 14.9,
   "speechStart": 14.9,
   "end": 19.05,
   "builds": 1,
   "text": "Table two gives the corrections for our subordinate station."
  },
  {
   "i": 5,
   "start": 19.3,
   "speechStart": 19.3,
   "end": 23.5,
   "builds": 0,
   "text": "High water: plus thirty-five minutes, plus zero point four feet."
  },
  {
   "i": 6,
   "start": 23.75,
   "speechStart": 23.75,
   "end": 28.075,
   "builds": 0,
   "text": "Low water: plus forty-eight minutes, minus zero point one feet."
  },
  {
   "i": 7,
   "start": 28.325,
   "speechStart": 28.325,
   "end": 30.025,
   "builds": 1,
   "text": "So high water."
  },
  {
   "i": 8,
   "start": 30.275,
   "speechStart": 30.275,
   "end": 34.55,
   "builds": 0,
   "text": "Ten forty-two plus thirty-five minutes is eleven seventeen."
  },
  {
   "i": 9,
   "start": 34.8,
   "speechStart": 34.8,
   "end": 39.95,
   "builds": 0,
   "text": "And the height is three point six plus zero point four, four point zero feet."
  },
  {
   "i": 10,
   "start": 40.2,
   "speechStart": 40.2,
   "end": 41.775,
   "builds": 1,
   "text": "Low water."
  },
  {
   "i": 11,
   "start": 42.025,
   "speechStart": 42.025,
   "end": 44.725,
   "builds": 0,
   "text": "Sixteen fifty plus forty-eight minutes."
  },
  {
   "i": 12,
   "start": 44.975,
   "speechStart": 44.975,
   "end": 46.875,
   "builds": 0,
   "text": "Careful with the minutes."
  },
  {
   "i": 13,
   "start": 47.125,
   "speechStart": 47.875,
   "end": 49.875,
   "builds": 0,
   "text": "Seventeen thirty-eight."
  },
  {
   "i": 14,
   "start": 50.125,
   "speechStart": 50.125,
   "end": 55.25,
   "builds": 0,
   "text": "And the height is zero point four minus zero point one, zero point three feet."
  },
  {
   "i": 15,
   "start": 55.5,
   "speechStart": 55.5,
   "end": 57.4,
   "builds": 1,
   "text": "Last step, in summer."
  },
  {
   "i": 16,
   "start": 57.65,
   "speechStart": 57.65,
   "end": 63.025,
   "builds": 0,
   "text": "Add an hour for daylight saving time: twelve seventeen and eighteen thirty-eight."
  },
  {
   "i": 17,
   "start": 63.275,
   "speechStart": 63.275,
   "end": 66.9,
   "builds": 0,
   "text": "Notice that highs and lows get their own corrections."
  },
  {
   "i": 18,
   "start": 67.15,
   "speechStart": 67.15,
   "end": 68.775,
   "builds": 0,
