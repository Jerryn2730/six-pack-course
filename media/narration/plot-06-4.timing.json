 "sentences": [
  {
   "i": 0,
   "start": 0.15,
   "speechStart": 0.15,
   "end": 2.4,
   "builds": 0,
   "text": "Let’s plot a two-bearing fix."
  },
  {
   "i": 1,
   "start": 2.65,
   "speechStart": 2.65,
   "end": 4.5,
   "builds": 0,
   "text": "Follow the diagram."
  },
  {
   "i": 2,
   "start": 4.75,
   "speechStart": 4.75,
   "end": 7.375,
   "builds": 1,
   "text": "At ten fifteen you take two bearings."
  },
  {
   "i": 3,
   "start": 7.625,
   "speechStart": 7.625,
   "end": 10.275,
   "builds": 0,
   "text": "A light bears three four zero true."
  },
  {
   "i": 4,
   "start": 10.525,
   "speechStart": 10.525,
   "end": 13.275,
   "builds": 0,
   "text": "A tower bears zero six five true."
  },
  {
   "i": 5,
   "start": 13.525,
   "speechStart": 13.525,
   "end": 15.2,
   "builds": 1,
   "text": "Start with the light."
  },
  {
   "i": 6,
   "start": 15.45,
   "speechStart": 15.45,
   "end": 19.025,
   "builds": 0,
   "text": "A bearing is the direction from you to the object."
  },
  {
   "i": 7,
   "start": 19.275,
   "speechStart": 19.275,
   "end": 23.5,
   "builds": 0,
   "text": "So from the light, which way do you draw the line back toward yourself?"
  },
  {
   "i": 8,
   "start": 23.75,
   "speechStart": 24.5,
   "end": 27.4,
   "builds": 0,
   "text": "Along the reciprocal: one six zero."
  },
  {
   "i": 9,
   "start": 27.65,
   "speechStart": 27.65,
   "end": 29.35,
   "builds": 1,
   "text": "Now the tower."
  },
  {
   "i": 10,
   "start": 29.6,
   "speechStart": 29.6,
   "end": 34.975,
   "builds": 0,
   "text": "It bears zero six five, so from the tower you draw back along two four five."
  },
  {
   "i": 11,
   "start": 35.225,
   "speechStart": 35.225,
   "end": 42.4,
   "builds": 1,
   "text": "The two lines are eighty-five degrees apart, which is nearly ideal, and they cross at your ten fifteen fix."
  },
  {
   "i": 12,
   "start": 42.65,
   "speechStart": 42.65,
   "end": 44.675,
   "builds": 0,
   "text": "Circle it and label it."
  },
  {
   "i": 13,
   "start": 44.925,
   "speechStart": 44.925,
   "end": 51.5,
   "builds": 1,
   "text": "Then read its latitude and longitude from the scales, because that’s usually what the question asks for."
  }
 ]
}
