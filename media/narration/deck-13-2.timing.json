 "sentences": [
  {
   "i": 0,
   "start": 0.15,
   "speechStart": 0.15,
   "end": 1.9,
   "builds": 0,
   "text": "Next, bleeding."
  },
  {
   "i": 1,
   "start": 2.15,
   "speechStart": 2.15,
   "end": 5.575,
   "builds": 0,
   "text": "Fishing boats are full of knives, hooks and gaffs."
  },
  {
   "i": 2,
   "start": 5.825,
   "speechStart": 5.825,
   "end": 12.95,
   "builds": 1,
   "text": "For serious bleeding, the first step is always the same: firm, direct pressure on the wound, with a dressing."
  },
  {
   "i": 3,
   "start": 13.2,
   "speechStart": 13.2,
   "end": 14.95,
   "builds": 0,
   "text": "And keep pressing."
  },
  {
   "i": 4,
   "start": 15.2,
   "speechStart": 15.2,
   "end": 17.075,
   "builds": 0,
   "text": "Don’t lift it to look."
  },
  {
   "i": 5,
   "start": 17.325,
   "speechStart": 17.325,
   "end": 23.4,
   "builds": 1,
   "text": "If it’s life-threatening bleeding from an arm or a leg, and pressure won’t stop it, use a tourniquet."
  },
  {
   "i": 6,
   "start": 23.65,
   "speechStart": 23.65,
   "end": 28.25,
   "builds": 0,
   "text": "High on the limb, tight enough to stop the bleeding, and write down the time."
  },
  {
   "i": 7,
   "start": 28.5,
   "speechStart": 28.5,
   "end": 32.6,
   "builds": 1,
   "text": "Then watch for shock: a dangerous drop in circulation."
  },
  {
   "i": 8,
   "start": 32.85,
   "speechStart": 32.85,
   "end": 34.575,
   "builds": 0,
   "text": "What does it look like?"
  },
  {
   "i": 9,
   "start": 34.825,
   "speechStart": 35.575,
   "end": 39.25,
   "builds": 0,
   "text": "Pale, cold, clammy skin, and a fast, weak pulse."
  },
  {
   "i": 10,
   "start": 39.5,
   "speechStart": 39.5,
   "end": 44.5,
   "builds": 1,
   "text": "Lay the person flat, keep them warm, and raise the legs if they aren’t injured."
  },
  {
   "i": 11,
   "start": 44.75,
   "speechStart": 44.75,
   "end": 48.75,
   "builds": 1,
   "text": "And give nothing to eat or drink to someone who’s seriously hurt."
  }
 ]
}
