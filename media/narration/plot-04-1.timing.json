 "sentences": [
  {
   "i": 0,
   "start": 0.15,
   "speechStart": 0.15,
   "end": 5.75,
   "builds": 0,
   "text": "There’s one formula in this module, and it’s worth more points than anything else you’ll learn here."
  },
  {
   "i": 1,
   "start": 6.0,
   "speechStart": 6.0,
   "end": 7.65,
   "builds": 0,
   "text": "Look at the screen."
  },
  {
   "i": 2,
   "start": 7.9,
   "speechStart": 7.9,
   "end": 11.575,
   "builds": 0,
   "text": "Sixty times distance, equals speed times time."
  },
  {
   "i": 3,
   "start": 11.825,
   "speechStart": 11.825,
   "end": 14.25,
   "builds": 0,
   "text": "Distance in nautical miles."
  },
  {
   "i": 4,
   "start": 14.5,
   "speechStart": 14.5,
   "end": 16.25,
   "builds": 0,
   "text": "Speed in knots."
  },
  {
   "i": 5,
   "start": 16.5,
   "speechStart": 16.5,
   "end": 18.125,
   "builds": 0,
   "text": "Time in minutes."
  },
  {
   "i": 6,
   "start": 18.375,
   "speechStart": 18.375,
   "end": 20.875,
   "builds": 0,
   "text": "Remember it as sixty D street."
  },
  {
   "i": 7,
   "start": 21.125,
   "speechStart": 21.125,
   "end": 23.025,
   "builds": 0,
   "text": "Sixty, D, S, T."
  },
  {
   "i": 8,
   "start": 23.275,
   "speechStart": 23.275,
   "end": 26.6,
   "builds": 0,
   "text": "From that one line, you can find any of the three."
  },
  {
   "i": 9,
   "start": 26.85,
   "speechStart": 26.85,
   "end": 30.625,
   "builds": 0,
   "text": "Time is sixty times distance, divided by speed."
  },
  {
   "i": 10,
   "start": 30.875,
   "speechStart": 30.875,
   "end": 34.725,
   "builds": 0,
   "text": "Distance is speed times time, divided by sixty."
  },
  {
   "i": 11,
   "start": 34.975,
   "speechStart": 34.975,
   "end": 38.75,
   "builds": 0,
   "text": "Speed is sixty times distance, divided by time."
  },
  {
   "i": 12,
   "start": 39.0,
   "speechStart": 39.0,
   "end": 40.8,
   "builds": 0,
   "text": "Try the example."
  },
  {
   "i": 13,
   "start": 41.05,
   "speechStart": 41.05,
   "end": 43.35,
   "builds": 0,
   "text": "Twelve miles, at eight knots."
  },
  {
   "i": 14,
   "start": 43.6,
   "speechStart": 43.6,
   "end": 45.15,
   "builds": 0,
   "text": "How long?"
  },
  {
   "i": 15,
   "start": 45.4,
   "speechStart": 46.15,
   "end": 49.425,
   "builds": 0,
   "text": "Sixty times twelve is seven hundred twenty."
  },
  {
   "i": 16,
   "start": 49.675,
   "speechStart": 49.675,
   "end": 52.4,
   "builds": 0,
   "text": "Divided by eight is ninety minutes."
  },
  {
   "i": 17,
   "start": 52.65,
   "speechStart": 52.65,
   "end": 54.6,
   "builds": 0,
   "text": "One thing to notice."
  },
  {
   "i": 18,
   "start": 54.85,
   "speechStart": 54.85,
   "end": 57.825,
   "builds": 0,
   "text": "The answer comes out in minutes, not hours."
  },
  {
   "i": 19,
   "start": 58.075,
   "speechStart": 58.075,
   "end": 60.775,
   "builds": 0,
   "text": "That’s the whole reason the sixty is there."
  }
 ]
}
