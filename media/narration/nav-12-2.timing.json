 "voice": "af_heart",
 "speed": 0.97,
 "buildCount": 5,
 "sentences": [
  {
   "i": 0,
   "start": 0.15,
   "speechStart": 0.15,
   "end": 5.525,
   "builds": 0,
   "text": "A radar is only as good as the way it’s tuned, and three knobs do most of the work."
  },
  {
   "i": 1,
   "start": 5.775,
   "speechStart": 5.775,
   "end": 8.6,
   "builds": 1,
   "text": "Gain is the overall sensitivity."
  },
  {
   "i": 2,
   "start": 8.85,
   "speechStart": 8.85,
   "end": 11.475,
   "builds": 0,
   "text": "Too low, and you miss weak targets."
  },
  {
   "i": 3,
   "start": 11.725,
   "speechStart": 11.725,
   "end": 14.575,
   "builds": 0,
   "text": "Too high, and the screen fills with speckle."
  },
  {
   "i": 4,
   "start": 14.825,
   "speechStart": 14.825,
   "end": 21.1,
   "builds": 1,
   "text": "Sea clutter control, also called S T C, cuts down the echoes from waves close to the boat."
  },
  {
   "i": 5,
   "start": 21.35,
   "speechStart": 21.35,
   "end": 26.7,
   "builds": 1,
   "text": "Rain clutter control, F T C, breaks up the solid smear of a rain squall."
  },
  {
   "i": 6,
   "start": 26.95,
   "speechStart": 26.95,
   "end": 29.2,
   "builds": 1,
   "text": "Here’s the danger in all three."
  },
  {
   "i": 7,
   "start": 29.45,
   "speechStart": 29.45,
   "end": 33.475,
   "builds": 0,
   "text": "Turn them up too far, and what disappears along with the clutter?"
  },
  {
   "i": 8,
   "start": 33.725,
   "speechStart": 34.475,
   "end": 36.25,
   "builds": 0,
   "text": "The real targets."
  },
  {
   "i": 9,
   "start": 36.5,
   "speechStart": 36.5,
   "end": 40.45,
   "builds": 0,
   "text": "A small boat or a buoy looks just like clutter to the radar."
  },
  {
   "i": 10,
   "start": 40.7,
   "speechStart": 40.7,
   "end": 42.975,
   "builds": 0,
   "text": "So use as little as you need."
  },
  {
   "i": 11,
   "start": 43.225,
   "speechStart": 43.225,
   "end": 44.85,
   "builds": 1,
   "text": "And the display."
  },
  {
   "i": 12,
   "start": 45.1,
   "speechStart": 45.1,
   "end": 47.425,
   "builds": 0,
   "text": "Head-up puts your heading straight up."
  },
  {
   "i": 13,
   "start": 47.675,
   "speechStart": 47.675,
   "end": 53.95,
   "builds": 0,
   "text": "North-up and course-up use a heading sensor to hold the picture steady, which makes plotting easier."
  }
 ]
}
