 "voice": "af_heart",
 "speed": 0.97,
 "buildCount": 5,
 "sentences": [
  {
   "i": 0,
   "start": 0.15,
   "speechStart": 0.15,
   "end": 3.675,
   "builds": 0,
   "text": "A last word on line, and it’s about staying alive."
  },
  {
   "i": 1,
   "start": 3.925,
   "speechStart": 3.925,
   "end": 9.85,
   "builds": 0,
   "text": "A line under load stores a huge amount of energy, and stretchy nylon stores the most."
  },
  {
   "i": 2,
   "start": 10.1,
   "speechStart": 10.1,
   "end": 14.9,
   "builds": 1,
   "text": "If that line parts, it snaps back like a whip, with enough force to kill."
  },
  {
   "i": 3,
   "start": 15.15,
   "speechStart": 15.15,
   "end": 17.125,
   "builds": 0,
   "text": "That’s called snap-back."
  },
  {
   "i": 4,
   "start": 17.375,
   "speechStart": 17.375,
   "end": 22.55,
   "builds": 1,
   "text": "So keep yourself, and your passengers, out of the path of any line under strain."
  },
  {
   "i": 5,
   "start": 22.8,
   "speechStart": 22.8,
   "end": 25.425,
   "builds": 0,
   "text": "When does that happen on a charter boat?"
  },
  {
   "i": 6,
   "start": 25.675,
   "speechStart": 26.425,
   "end": 30.55,
   "builds": 0,
   "text": "When you’re towing, and when the boat surges against her dock lines."
  },
  {
   "i": 7,
   "start": 30.8,
   "speechStart": 30.8,
   "end": 34.875,
   "builds": 1,
   "text": "Never stand inside a bight, a loop of line lying on deck."
  },
  {
   "i": 8,
   "start": 35.125,
   "speechStart": 35.125,
   "end": 38.025,
   "builds": 0,
   "text": "If it comes tight, it takes your leg with it."
  },
  {
   "i": 9,
   "start": 38.275,
   "speechStart": 38.275,
   "end": 41.1,
   "builds": 1,
   "text": "Use a line that’s big enough for the load."
  },
  {
   "i": 10,
   "start": 41.35,
   "speechStart": 41.35,
   "end": 47.4,
   "builds": 1,
   "text": "And inspect your lines for chafe, stiffness and sun damage, and replace them before they fail."
  },
  {
   "i": 11,
   "start": 47.65,
   "speechStart": 47.65,
   "end": 49.45,
   "builds": 0,
   "text": "That’s lesson eight."
  },
  {
   "i": 12,
   "start": 49.7,
   "speechStart": 49.7,
   "end": 52.9,
   "builds": 0,
   "text": "Nylon stretches, polypropylene floats."
  },
  {
   "i": 13,
   "start": 53.15,
   "speechStart": 53.15,
   "end": 55.125,
   "builds": 0,
   "text": "Splice what’s permanent."
  },
  {
   "i": 14,
   "start": 55.375,
   "speechStart": 55.375,
   "end": 57.475,
   "builds": 0,
   "text": "Springs stop her surging."
  },
  {
   "i": 15,
   "start": 57.725,
   "speechStart": 57.725,
   "end": 60.15,
   "builds": 0,
   "text": "And stay out of the snap-back zone."
  },
  {
   "i": 16,
   "start": 60.4,
   "speechStart": 60.4,
   "end": 62.575,
   "builds": 0,
   "text": "Next time: anchoring."
  }
 ]
}
