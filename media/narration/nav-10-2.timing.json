   "start": 0.15,
   "speechStart": 0.15,
   "end": 3.55,
   "builds": 0,
   "text": "A relative bearing ignores north altogether."
  },
  {
   "i": 1,
   "start": 3.8,
   "speechStart": 3.8,
   "end": 6.025,
   "builds": 0,
   "text": "It’s measured from your own bow."
  },
  {
   "i": 2,
   "start": 6.275,
   "speechStart": 6.275,
   "end": 8.1,
   "builds": 0,
   "text": "Look at the diagram."
  },
  {
   "i": 3,
   "start": 8.35,
   "speechStart": 8.35,
   "end": 10.875,
   "builds": 0,
   "text": "Zero zero zero is dead ahead."
  },
  {
   "i": 4,
   "start": 11.125,
   "speechStart": 11.125,
   "end": 14.4,
   "builds": 0,
   "text": "Zero nine zero is on your starboard beam."
  },
  {
   "i": 5,
   "start": 14.65,
   "speechStart": 14.65,
   "end": 17.05,
   "builds": 0,
   "text": "One eight zero is dead astern."
  },
  {
   "i": 6,
   "start": 17.3,
   "speechStart": 17.3,
   "end": 20.275,
   "builds": 0,
   "text": "Two seven zero is on your port beam."
  },
  {
   "i": 7,
   "start": 20.525,
   "speechStart": 20.525,
   "end": 23.3,
   "builds": 0,
   "text": "It always runs clockwise from the bow."
  },
  {
   "i": 8,
   "start": 23.55,
   "speechStart": 23.55,
   "end": 28.175,
   "builds": 0,
   "text": "To turn a relative bearing into a true bearing, add it to your true heading."
  },
  {
   "i": 9,
   "start": 28.425,
   "speechStart": 28.425,
   "end": 33.45,
   "builds": 0,
   "text": "If the total goes over three hundred sixty, subtract three hundred sixty."
  },
  {
   "i": 10,
   "start": 33.7,
   "speechStart": 33.7,
   "end": 35.225,
   "builds": 0,
   "text": "Try one."
  },
  {
   "i": 11,
   "start": 35.475,
   "speechStart": 35.475,
   "end": 37.875,
   "builds": 0,
   "text": "Your true heading is three hundred."
  },
  {
   "i": 12,
   "start": 38.125,
   "speechStart": 38.125,
   "end": 41.025,
   "builds": 0,
   "text": "A buoy bears zero nine zero relative."
  },
  {
   "i": 13,
   "start": 41.275,
   "speechStart": 41.275,
   "end": 43.125,
   "builds": 0,
   "text": "What’s its true bearing?"
  },
  {
   "i": 14,
   "start": 43.375,
   "speechStart": 44.125,
   "end": 47.175,
   "builds": 0,
   "text": "Three hundred plus ninety is three ninety."
  },
  {
   "i": 15,
   "start": 47.425,
   "speechStart": 47.425,
   "end": 49.45,
   "builds": 0,
   "text": "Take away three sixty."
  },
  {
   "i": 16,
   "start": 49.7,
   "speechStart": 49.7,
   "end": 51.875,
   "builds": 0,
   "text": "Zero three zero true."
  },
  {
   "i": 17,
   "start": 52.125,
   "speechStart": 52.125,
   "end": 54.8,
   "builds": 0,
   "text": "Lookouts report this way all the time."
  },
  {
   "i": 18,
   "start": 55.05,
   "speechStart": 55.05,
   "end": 59.35,
   "builds": 0,
   "text": "Broad on the starboard bow means about forty-five degrees relative."
  }
 ]
