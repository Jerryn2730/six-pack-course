 "sentences": [
  {
   "i": 0,
   "start": 0.15,
   "speechStart": 0.15,
   "end": 3.525,
   "builds": 0,
   "text": "Let’s pull the whole buoyage system into one table."
  },
  {
   "i": 1,
   "start": 3.775,
   "speechStart": 3.775,
   "end": 8.65,
   "builds": 0,
   "text": "If you know this table, you can name almost any mark the exam describes."
  },
  {
   "i": 2,
   "start": 8.9,
   "speechStart": 8.9,
   "end": 12.8,
   "builds": 1,
   "text": "Starboard-side lateral marks: red, with a red light."
  },
  {
   "i": 3,
   "start": 13.05,
   "speechStart": 13.05,
   "end": 16.875,
   "builds": 1,
   "text": "Port-side lateral marks: green, with a green light."
  },
  {
   "i": 4,
   "start": 17.125,
   "speechStart": 17.125,
   "end": 25.4,
   "builds": 1,
   "text": "Preferred channel marks: red and green bands, with a composite group-flashing light, two plus one, in the color of the top band."
  },
  {
   "i": 5,
   "start": 25.65,
   "speechStart": 25.65,
   "end": 31.575,
   "builds": 1,
   "text": "Safe water marks: red and white vertical stripes, with a white light flashing Morse A."
  },
  {
   "i": 6,
   "start": 31.825,
   "speechStart": 31.825,
   "end": 38.025,
   "builds": 1,
   "text": "Isolated danger marks: black with red bands, and a white light flashing in groups of two."
  },
  {
   "i": 7,
   "start": 38.275,
   "speechStart": 38.275,
   "end": 41.4,
   "builds": 1,
   "text": "Special marks: yellow, with a yellow light."
  },
  {
   "i": 8,
   "start": 41.65,
   "speechStart": 42.4,
   "end": 44.625,
   "builds": 0,
   "text": "Notice the pattern in the lights."
  },
  {
   "i": 9,
   "start": 44.875,
   "speechStart": 44.875,
   "end": 48.4,
   "builds": 0,
   "text": "Red and green lights are only on lateral marks."
  },
  {
   "i": 10,
   "start": 48.65,
   "speechStart": 48.65,
   "end": 52.45,
   "builds": 0,
   "text": "White lights are on safe water and isolated danger."
  },
  {
   "i": 11,
   "start": 52.7,
   "speechStart": 52.7,
   "end": 54.55,
   "builds": 0,
   "text": "Yellow is special."
  },
  {
   "i": 12,
   "start": 54.8,
   "speechStart": 54.8,
   "end": 56.675,
   "builds": 0,
   "text": "That’s lesson four."
  },
  {
   "i": 13,
   "start": 56.925,
   "speechStart": 56.925,
   "end": 59.175,
   "builds": 0,
   "text": "Morse A means safe water."
  },
  {
   "i": 14,
   "start": 59.425,
   "speechStart": 59.425,
   "end": 62.325,
   "builds": 0,
   "text": "Two balls and two flashes mean danger."
  },
  {
   "i": 15,
   "start": 62.575,
   "speechStart": 62.575,
   "end": 65.375,
   "builds": 0,
   "text": "On the Intracoastal, follow the yellow."
  },
  {
   "i": 16,
   "start": 65.625,
   "speechStart": 65.625,
   "end": 69.025,
   "builds": 0,
   "text": "Next time: lights, and how far you can see them."
  }
 ]
