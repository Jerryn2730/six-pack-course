 "sentences": [
  {
   "i": 0,
   "start": 0.15,
   "speechStart": 0.15,
   "end": 6.675,
   "builds": 0,
   "text": "Fuel is the same arithmetic with higher stakes, and there’s a rule that has brought a lot of captains home."
  },
  {
   "i": 1,
   "start": 6.925,
   "speechStart": 6.925,
   "end": 8.75,
   "builds": 0,
   "text": "The rule of thirds."
  },
  {
   "i": 2,
   "start": 9.0,
   "speechStart": 9.0,
   "end": 11.475,
   "builds": 0,
   "text": "One third of your fuel to go out."
  },
  {
   "i": 3,
   "start": 11.725,
   "speechStart": 11.725,
   "end": 13.725,
   "builds": 0,
   "text": "One third to come back."
  },
  {
   "i": 4,
   "start": 13.975,
   "speechStart": 13.975,
   "end": 16.375,
   "builds": 0,
   "text": "And one third held in reserve."
  },
  {
   "i": 5,
   "start": 16.625,
   "speechStart": 16.625,
   "end": 18.525,
   "builds": 0,
   "text": "Work one on screen."
  },
  {
   "i": 6,
   "start": 18.775,
   "speechStart": 18.775,
   "end": 23.075,
   "builds": 1,
   "text": "Your spot is forty-two miles out, and you cruise at fourteen knots."
  },
  {
   "i": 7,
   "start": 23.325,
   "speechStart": 23.325,
   "end": 25.475,
   "builds": 0,
   "text": "That’s three hours each way."
  },
  {
   "i": 8,
   "start": 25.725,
   "speechStart": 25.725,
   "end": 28.175,
   "builds": 1,
   "text": "You burn eighteen gallons an hour."
  },
  {
   "i": 9,
   "start": 28.425,
   "speechStart": 28.425,
   "end": 31.675,
   "builds": 0,
   "text": "Three hours is fifty-four gallons, one way."
  },
  {
   "i": 10,
   "start": 31.925,
   "speechStart": 31.925,
   "end": 34.2,
   "builds": 1,
   "text": "Now apply the rule of thirds."
  },
  {
   "i": 11,
   "start": 34.45,
   "speechStart": 34.45,
   "end": 36.975,
   "builds": 1,
   "text": "Fifty-four gallons is one third."
  },
  {
   "i": 12,
   "start": 37.225,
   "speechStart": 37.225,
   "end": 40.025,
   "builds": 0,
   "text": "So how much do you need aboard when you leave?"
  },
  {
   "i": 13,
   "start": 40.275,
   "speechStart": 41.025,
   "end": 43.05,
   "builds": 0,
   "text": "Three times fifty-four."
  },
  {
   "i": 14,
   "start": 43.3,
   "speechStart": 43.3,
   "end": 45.775,
   "builds": 0,
   "text": "One hundred sixty-two gallons."
  },
  {
   "i": 15,
   "start": 46.025,
   "speechStart": 46.025,
   "end": 48.05,
   "builds": 1,
   "text": "And that’s for a calm day."
  },
  {
   "i": 16,
   "start": 48.3,
   "speechStart": 48.3,
   "end": 52.05,
   "builds": 0,
   "text": "Rough seas, head winds and heavy loads all burn more."
  },
  {
   "i": 17,
   "start": 52.3,
   "speechStart": 52.3,
   "end": 54.275,
   "builds": 0,
   "text": "So be conservative."
  }
 ]
}
