   "speechStart": 0.15,
   "end": 3.875,
   "builds": 0,
   "text": "A few more, and then the habit that protects you afterward."
  },
  {
   "i": 1,
   "start": 4.125,
   "speechStart": 4.125,
   "end": 5.6,
   "builds": 1,
   "text": "Burns."
  },
  {
   "i": 2,
   "start": 5.85,
   "speechStart": 5.85,
   "end": 12.8,
   "builds": 0,
   "text": "Cool the area under cool running water for ten to twenty minutes, then cover it loosely with a clean dressing."
  },
  {
   "i": 3,
   "start": 13.05,
   "speechStart": 13.05,
   "end": 15.65,
   "builds": 0,
   "text": "No ice, no butter, no ointment."
  },
  {
   "i": 4,
   "start": 15.9,
   "speechStart": 15.9,
   "end": 17.95,
   "builds": 1,
   "text": "A suspected fracture."
  },
  {
   "i": 5,
   "start": 18.2,
   "speechStart": 18.2,
   "end": 23.775,
   "builds": 0,
   "text": "Immobilize the limb the way you found it, and check the circulation beyond the injury."
  },
  {
   "i": 6,
   "start": 24.025,
   "speechStart": 24.025,
   "end": 28.65,
   "builds": 1,
   "text": "A possible head, neck or back injury, say from a fall in rough seas."
  },
  {
   "i": 7,
   "start": 28.9,
   "speechStart": 28.9,
   "end": 33.275,
   "builds": 0,
   "text": "Keep them still, and don’t move them unless they’re in danger where they are."
  },
  {
   "i": 8,
   "start": 33.525,
   "speechStart": 33.525,
   "end": 35.375,
   "builds": 1,
   "text": "Something in the eye."
  },
  {
   "i": 9,
   "start": 35.625,
   "speechStart": 35.625,
   "end": 37.15,
   "builds": 0,
   "text": "Don’t rub it."
  },
  {
   "i": 10,
   "start": 37.4,
   "speechStart": 37.4,
   "end": 39.525,
   "builds": 0,
   "text": "Flush it with clean water."
  },
  {
   "i": 11,
   "start": 39.775,
   "speechStart": 39.775,
   "end": 42.175,
   "builds": 1,
   "text": "And when it’s over, write it down."
  },
  {
   "i": 12,
   "start": 42.425,
   "speechStart": 42.425,
   "end": 45.775,
   "builds": 0,
   "text": "What happened, what you saw, what you did, and when."
  },
  {
   "i": 13,
   "start": 46.025,
   "speechStart": 46.025,
   "end": 47.7,
   "builds": 0,
   "text": "Who needs that?"
  },
  {
   "i": 14,
   "start": 47.95,
   "speechStart": 48.7,
   "end": 51.9,
   "builds": 0,
   "text": "The medical team, and your casualty report."
  },
  {
   "i": 15,
   "start": 52.15,
   "speechStart": 52.15,
   "end": 54.175,
   "builds": 0,
   "text": "That’s lesson thirteen."
  },
  {
   "i": 16,
   "start": 54.425,
   "speechStart": 54.425,
   "end": 56.025,
   "builds": 0,
   "text": "Call early."
  },
  {
   "i": 17,
   "start": 56.275,
   "speechStart": 56.275,
   "end": 58.25,
   "builds": 0,
   "text": "Direct pressure first."
  },
  {
   "i": 18,
   "start": 58.5,
   "speechStart": 58.5,
   "end": 61.525,
   "builds": 0,
   "text": "Cool and sweaty, or hot and confused."
  },
  {
   "i": 19,
   "start": 61.775,
   "speechStart": 61.775,
   "end": 65.45,
   "builds": 0,
   "text": "Hot water for spines, seawater for jellyfish."
  },
  {
   "i": 20,
   "start": 65.7,
   "speechStart": 65.7,
   "end": 68.5,
   "builds": 0,
   "text": "Next time: keeping the water clean."
  }
 ]
