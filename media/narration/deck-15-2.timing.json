   "speechStart": 0.15,
   "end": 2.275,
   "builds": 0,
   "text": "And here’s how you report."
  },
  {
   "i": 1,
   "start": 2.525,
   "speechStart": 2.525,
   "end": 7.5,
   "builds": 1,
   "text": "First, notify the nearest Coast Guard sector or station immediately."
  },
  {
   "i": 2,
   "start": 7.75,
   "speechStart": 7.75,
   "end": 12.025,
   "builds": 0,
   "text": "That means as soon as the emergency itself is under control."
  },
  {
   "i": 3,
   "start": 12.275,
   "speechStart": 12.275,
   "end": 17.9,
   "builds": 1,
   "text": "Then file the written report, Form C G twenty-six ninety-two, within five days."
  },
  {
   "i": 4,
   "start": 18.15,
   "speechStart": 18.15,
   "end": 27.075,
   "builds": 1,
   "text": "If it’s a serious marine incident, for instance one with a death or a serious injury, drug and alcohol testing is required as well."
  },
  {
   "i": 5,
   "start": 27.325,
   "speechStart": 27.325,
   "end": 29.75,
   "builds": 0,
   "text": "Remember the clock from lesson one?"
  },
  {
   "i": 6,
   "start": 30.0,
   "speechStart": 30.75,
   "end": 33.05,
   "builds": 0,
   "text": "Alcohol within two hours."
  },
  {
   "i": 7,
   "start": 33.3,
   "speechStart": 33.3,
   "end": 38.45,
   "builds": 1,
   "text": "Keep your evidence: logbook entries, photographs, and the names of witnesses."
  },
  {
   "i": 8,
   "start": 38.7,
   "speechStart": 38.7,
   "end": 40.575,
   "builds": 0,
   "text": "Write it while it’s fresh."
  },
  {
   "i": 9,
   "start": 40.825,
   "speechStart": 40.825,
   "end": 43.35,
   "builds": 1,
   "text": "And one distinction for the exam."
  },
  {
   "i": 10,
   "start": 43.6,
   "speechStart": 43.6,
   "end": 46.475,
   "builds": 0,
   "text": "These rules are for commercial vessels."
  },
  {
   "i": 11,
   "start": 46.725,
   "speechStart": 46.725,
   "end": 51.275,
   "builds": 0,
   "text": "Accidents on recreational boats are reported to the state instead."
  }
