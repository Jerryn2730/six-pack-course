 "sentences": [
  {
   "i": 0,
   "start": 0.15,
   "speechStart": 0.15,
   "end": 5.675,
   "builds": 0,
   "text": "Twin screws change everything, and once you learn them, you’ll never want one engine again."
  },
  {
   "i": 1,
   "start": 5.925,
   "speechStart": 5.925,
   "end": 12.075,
   "builds": 1,
   "text": "Most twin-screw boats have counter-rotating propellers, so each one cancels the other’s walk."
  },
  {
   "i": 2,
   "start": 12.325,
   "speechStart": 12.325,
   "end": 17.0,
   "builds": 1,
   "text": "Put one engine ahead and the other astern, and the boat spins in place."
  },
  {
   "i": 3,
   "start": 17.25,
   "speechStart": 17.25,
   "end": 18.775,
   "builds": 0,
   "text": "Which way?"
  },
  {
   "i": 4,
   "start": 19.025,
   "speechStart": 19.025,
   "end": 20.675,
   "builds": 0,
   "text": "Think of a tank."
  },
  {
   "i": 5,
   "start": 20.925,
   "speechStart": 20.925,
   "end": 25.825,
   "builds": 0,
   "text": "Starboard engine ahead, port engine astern, and the bow swings to port."
  },
  {
   "i": 6,
   "start": 26.075,
   "speechStart": 26.075,
   "end": 28.9,
   "builds": 0,
   "text": "Swap them, and it swings to starboard."
  },
  {
   "i": 7,
   "start": 29.15,
   "speechStart": 29.15,
   "end": 33.15,
   "builds": 1,
   "text": "Around the docks, center the rudders and leave the wheel alone."
  },
  {
   "i": 8,
   "start": 33.4,
   "speechStart": 33.4,
   "end": 35.275,
   "builds": 0,
   "text": "Steer with the engines."
  },
  {
   "i": 9,
   "start": 35.525,
   "speechStart": 35.525,
   "end": 39.325,
   "builds": 1,
   "text": "And use small bursts, with plenty of neutral in between."
  },
  {
   "i": 10,
   "start": 39.575,
   "speechStart": 39.575,
   "end": 42.25,
   "builds": 0,
   "text": "What’s the commonest mistake with twins?"
  },
  {
   "i": 11,
   "start": 42.5,
   "speechStart": 43.25,
   "end": 45.125,
   "builds": 0,
   "text": "Leaving them in gear."
  },
  {
   "i": 12,
   "start": 45.375,
   "speechStart": 45.375,
   "end": 52.35,
   "builds": 0,
   "text": "A boat keeps moving long after you take her out of gear, so click in, click out, and wait to see what she does."
  }
 ]
}
