 "buildCount": 5,
 "sentences": [
  {
   "i": 0,
   "start": 0.15,
   "speechStart": 0.15,
   "end": 1.95,
   "builds": 0,
   "text": "Help is on the way."
  },
  {
   "i": 1,
   "start": 2.2,
   "speechStart": 2.2,
   "end": 5.2,
   "builds": 0,
   "text": "Now your job is to make the rescue easy."
  },
  {
   "i": 2,
   "start": 5.45,
   "speechStart": 5.45,
   "end": 8.575,
   "builds": 1,
   "text": "Follow the rescuers’ instructions exactly."
  },
  {
   "i": 3,
   "start": 8.825,
   "speechStart": 8.825,
   "end": 12.4,
   "builds": 0,
   "text": "They may ask you to hold a particular course and speed."
  },
  {
   "i": 4,
   "start": 12.65,
   "speechStart": 12.65,
   "end": 15.025,
   "builds": 0,
   "text": "Do it, even if it seems odd."
  },
  {
   "i": 5,
   "start": 15.275,
   "speechStart": 15.275,
   "end": 20.9,
   "builds": 1,
   "text": "Before a helicopter arrives, secure everything loose: gear, canvas, antennas."
  },
  {
   "i": 6,
   "start": 21.15,
   "speechStart": 21.15,
   "end": 23.825,
   "builds": 0,
   "text": "The rotor wash is like a hurricane."
  },
  {
   "i": 7,
   "start": 24.075,
   "speechStart": 24.075,
   "end": 27.575,
   "builds": 1,
   "text": "When they lower the basket or the hook, don’t reach for it."
  },
  {
   "i": 8,
   "start": 27.825,
   "speechStart": 27.825,
   "end": 30.475,
   "builds": 0,
   "text": "Let it touch the water or the deck first."
  },
  {
   "i": 9,
   "start": 30.725,
   "speechStart": 30.725,
   "end": 31.975,
   "builds": 0,
   "text": "Why?"
  },
  {
   "i": 10,
   "start": 32.225,
   "speechStart": 32.975,
   "end": 40.725,
   "builds": 0,
   "text": "A hovering helicopter builds up a powerful static charge, and it goes to ground through the first thing the cable touches."
  },
  {
   "i": 11,
   "start": 40.975,
   "speechStart": 40.975,
   "end": 42.75,
   "builds": 0,
   "text": "Don’t let that be you."
  },
  {
   "i": 12,
   "start": 43.0,
   "speechStart": 43.0,
   "end": 45.8,
   "builds": 1,
   "text": "Never tie the hoist cable to your boat."
  },
  {
   "i": 13,
   "start": 46.05,
   "speechStart": 46.05,
   "end": 49.575,
   "builds": 0,
   "text": "If the helicopter has to move, it must be free."
  },
  {
   "i": 14,
   "start": 49.825,
   "speechStart": 49.825,
   "end": 56.625,
   "builds": 1,
   "text": "And keep everyone in life jackets, with a light, a flare or a signal mirror ready to show them where you are."
  }
 ]
}
