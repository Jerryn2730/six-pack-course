 "sentences": [
  {
   "i": 0,
   "start": 0.15,
   "speechStart": 0.15,
   "end": 3.3,
   "builds": 0,
   "text": "Two bearings aren’t the only way to get a fix."
  },
  {
   "i": 1,
   "start": 3.55,
   "speechStart": 3.55,
   "end": 8.25,
   "builds": 1,
   "text": "A bearing and a radar range on the same object make an excellent one."
  },
  {
   "i": 2,
   "start": 8.5,
   "speechStart": 8.5,
   "end": 13.575,
   "builds": 0,
   "text": "The line and the circle cross at a right angle, and you only need one landmark."
  },
  {
   "i": 3,
   "start": 13.825,
   "speechStart": 13.825,
   "end": 18.65,
   "builds": 1,
   "text": "Radar ranges to two different objects give two circles, and they cross."
  },
  {
   "i": 4,
   "start": 18.9,
   "speechStart": 18.9,
   "end": 23.15,
   "builds": 1,
   "text": "A range line, plus a bearing on something else, works very well."
  },
  {
   "i": 5,
   "start": 23.4,
   "speechStart": 23.4,
   "end": 29.1,
   "builds": 1,
   "text": "A GPS fix is marked with a small triangle, so you can tell it from a visual fix."
  },
  {
   "i": 6,
   "start": 29.35,
   "speechStart": 29.35,
   "end": 33.575,
   "builds": 1,
   "text": "And whatever method you use, cross-check it against another source."
  },
  {
   "i": 7,
   "start": 33.825,
   "speechStart": 33.825,
   "end": 36.1,
   "builds": 0,
   "text": "What’s the easiest check you have?"
  },
  {
   "i": 8,
   "start": 36.35,
   "speechStart": 37.1,
   "end": 38.825,
   "builds": 0,
   "text": "The depth sounder."
  },
  {
   "i": 9,
   "start": 39.075,
   "speechStart": 39.075,
   "end": 43.8,
   "builds": 0,
   "text": "If the fix says twenty feet and the sounder says six, believe the sounder."
  },
  {
   "i": 10,
   "start": 44.05,
   "speechStart": 44.05,
   "end": 45.95,
   "builds": 0,
   "text": "That’s lesson six."
  },
  {
   "i": 11,
   "start": 46.2,
   "speechStart": 46.2,
   "end": 48.7,
   "builds": 0,
   "text": "Draw bearings back from the object."
  },
  {
   "i": 12,
   "start": 48.95,
   "speechStart": 48.95,
   "end": 51.35,
   "builds": 0,
   "text": "Cross them near ninety degrees."
  },
  {
   "i": 13,
   "start": 51.6,
   "speechStart": 51.6,
   "end": 53.975,
   "builds": 0,
   "text": "A big cocked hat means a mistake."
  },
  {
   "i": 14,
   "start": 54.225,
   "speechStart": 54.225,
   "end": 56.525,
   "builds": 0,
   "text": "Next time: dead reckoning."
  }
