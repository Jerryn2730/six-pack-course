   "speechStart": 0.15,
   "end": 6.3,
   "builds": 0,
   "text": "Good radio habits make you sound like a professional, and more important, they make you understood."
  },
  {
   "i": 1,
   "start": 6.55,
   "speechStart": 6.55,
   "end": 9.675,
   "builds": 1,
   "text": "Use the phonetic alphabet to spell things out."
  },
  {
   "i": 2,
   "start": 9.925,
   "speechStart": 9.925,
   "end": 12.5,
   "builds": 0,
   "text": "Alfa, Bravo, Charlie, Delta."
  },
  {
   "i": 3,
   "start": 12.75,
   "speechStart": 12.75,
   "end": 16.85,
   "builds": 0,
   "text": "On a crackling radio, B and D and E all sound alike."
  },
  {
   "i": 4,
   "start": 17.1,
   "speechStart": 17.1,
   "end": 19.475,
   "builds": 1,
   "text": "Say over when you want a reply."
  },
  {
   "i": 5,
   "start": 19.725,
   "speechStart": 19.725,
   "end": 22.5,
   "builds": 0,
   "text": "Say out when the conversation is finished."
  },
  {
   "i": 6,
   "start": 22.75,
   "speechStart": 22.75,
   "end": 24.85,
   "builds": 0,
   "text": "And over and out together?"
  },
  {
   "i": 7,
   "start": 25.1,
   "speechStart": 25.85,
   "end": 27.65,
   "builds": 0,
   "text": "It makes no sense."
  },
  {
   "i": 8,
   "start": 27.9,
   "speechStart": 27.9,
   "end": 30.7,
   "builds": 0,
   "text": "It means, reply to me, I’m finished."
  },
  {
   "i": 9,
   "start": 30.95,
   "speechStart": 30.95,
   "end": 36.1,
   "builds": 1,
   "text": "Radio checks go on a working channel, or an automated radio-check service."
  },
  {
   "i": 10,
   "start": 36.35,
   "speechStart": 36.35,
   "end": 38.35,
   "builds": 0,
   "text": "Never on sixteen."
  },
  {
   "i": 11,
   "start": 38.6,
   "speechStart": 38.6,
   "end": 43.725,
   "builds": 1,
   "text": "Make your first call on sixteen or nine, then move to a working channel to talk."
  },
  {
   "i": 12,
   "start": 43.975,
   "speechStart": 43.975,
   "end": 48.875,
   "builds": 0,
   "text": "Sixteen is for calling and for distress, not for chatting about the bite."
  },
  {
   "i": 13,
   "start": 49.125,
   "speechStart": 49.125,
   "end": 51.675,
   "builds": 1,
   "text": "And never make a false distress call."
  },
  {
   "i": 14,
   "start": 51.925,
   "speechStart": 51.925,
   "end": 57.15,
   "builds": 0,
   "text": "It’s a federal crime, and it can cost you fines, prison, and the bill for the search."
  }
 ]
