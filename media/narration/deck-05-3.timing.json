 "voice": "af_heart",
 "speed": 0.97,
 "buildCount": 5,
 "sentences": [
  {
   "i": 0,
   "start": 0.15,
   "speechStart": 0.15,
   "end": 4.45,
   "builds": 0,
   "text": "On a charter, the biggest stability problem isn’t fuel or ice."
  },
  {
   "i": 1,
   "start": 4.7,
   "speechStart": 4.7,
   "end": 6.3,
   "builds": 0,
   "text": "It’s people."
  },
  {
   "i": 2,
   "start": 6.55,
   "speechStart": 6.55,
   "end": 8.025,
   "builds": 1,
   "text": "Picture it."
  },
  {
   "i": 3,
   "start": 8.275,
   "speechStart": 8.275,
   "end": 14.75,
   "builds": 0,
   "text": "Somebody hooks a big kingfish on the port side, and all six passengers rush to the port rail to watch."
  },
  {
   "i": 4,
   "start": 15.0,
   "speechStart": 15.0,
   "end": 18.875,
   "builds": 0,
   "text": "On a small boat, that alone can swamp or capsize her."
  },
  {
   "i": 5,
   "start": 19.125,
   "speechStart": 19.125,
   "end": 22.3,
   "builds": 0,
   "text": "So what do you say before lines go in the water?"
  },
  {
   "i": 6,
   "start": 22.55,
   "speechStart": 23.3,
   "end": 25.025,
   "builds": 0,
   "text": "Stay spread out."
  },
  {
   "i": 7,
   "start": 25.275,
   "speechStart": 25.275,
   "end": 28.175,
   "builds": 0,
   "text": "One or two at the rail, the rest stay put."
  },
  {
   "i": 8,
   "start": 28.425,
   "speechStart": 28.425,
   "end": 33.3,
   "builds": 1,
   "text": "Keep heavy things, coolers, ice and gear, low and near the centerline."
  },
  {
   "i": 9,
   "start": 33.55,
   "speechStart": 33.55,
   "end": 36.875,
   "builds": 1,
   "text": "On small boats, respect the capacity plate."
  },
  {
   "i": 10,
   "start": 37.125,
   "speechStart": 37.125,
   "end": 40.325,
   "builds": 1,
   "text": "And remember that your loading changes all day."
  },
  {
   "i": 11,
   "start": 40.575,
   "speechStart": 40.575,
   "end": 44.775,
   "builds": 0,
   "text": "You burn off fuel, the ice melts, and the fish box fills up."
  },
  {
   "i": 12,
   "start": 45.025,
   "speechStart": 45.025,
   "end": 48.275,
   "builds": 0,
   "text": "The boat you bring home isn’t the boat you took out."
  },
  {
   "i": 13,
   "start": 48.525,
   "speechStart": 48.525,
   "end": 54.425,
   "builds": 1,
   "text": "Finally, water trapped on deck is free surface, right where you can least afford it: up high."
  }
 ]
}
