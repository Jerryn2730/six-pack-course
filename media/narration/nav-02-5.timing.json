 "voice": "af_heart",
 "speed": 0.97,
 "buildCount": 5,
 "sentences": [
  {
   "i": 0,
   "start": 0.15,
   "speechStart": 0.15,
   "end": 2.35,
   "builds": 0,
   "text": "Two last things about charts."
  },
  {
   "i": 1,
   "start": 2.6,
   "speechStart": 2.6,
   "end": 7.2,
   "builds": 1,
   "text": "First, read every note printed on a chart before you navigate with it."
  },
  {
   "i": 2,
   "start": 7.45,
   "speechStart": 7.45,
   "end": 13.75,
   "builds": 1,
   "text": "The notes cover regulations, cautions about shoaling or unreliable aids, and the datums."
  },
  {
   "i": 3,
   "start": 14.0,
   "speechStart": 14.0,
   "end": 17.15,
   "builds": 0,
   "text": "They’re the fine print, and they’re there for a reason."
  },
  {
   "i": 4,
   "start": 17.4,
   "speechStart": 17.4,
   "end": 21.0,
   "builds": 0,
   "text": "Second, electronic charts, which come in two kinds."
  },
  {
   "i": 5,
   "start": 21.25,
   "speechStart": 21.25,
   "end": 24.925,
   "builds": 1,
   "text": "Raster charts are scanned pictures of the paper chart."
  },
  {
   "i": 6,
   "start": 25.175,
   "speechStart": 25.175,
   "end": 27.25,
   "builds": 0,
   "text": "They look exactly like it."
  },
  {
   "i": 7,
   "start": 27.5,
   "speechStart": 27.5,
   "end": 34.6,
   "builds": 1,
   "text": "Electronic navigational charts, or E N Cs, are vector data that your plotter draws for itself."
  },
  {
   "i": 8,
   "start": 34.85,
   "speechStart": 34.85,
   "end": 37.6,
   "builds": 0,
   "text": "They’re powerful, but they have one trap."
  },
  {
   "i": 9,
   "start": 37.85,
   "speechStart": 37.85,
   "end": 41.0,
   "builds": 0,
   "text": "When you zoom out, what happens to the detail?"
  },
  {
   "i": 10,
   "start": 41.25,
   "speechStart": 42.0,
   "end": 43.75,
   "builds": 0,
   "text": "It disappears."
  },
  {
   "i": 11,
   "start": 44.0,
   "speechStart": 44.0,
   "end": 46.425,
   "builds": 0,
   "text": "A rock can vanish from the screen."
  },
  {
   "i": 12,
   "start": 46.675,
   "speechStart": 46.675,
   "end": 50.075,
   "builds": 0,
   "text": "So zoom in along your whole route before you run it."
  },
  {
   "i": 13,
   "start": 50.325,
   "speechStart": 50.325,
   "end": 54.2,
   "builds": 1,
   "text": "And whichever kind you use, make sure it’s the current edition."
  },
  {
   "i": 14,
   "start": 54.45,
   "speechStart": 54.45,
   "end": 56.35,
   "builds": 0,
   "text": "That’s lesson two."
  },
  {
   "i": 15,
   "start": 56.6,
   "speechStart": 56.6,
   "end": 58.375,
   "builds": 0,
   "text": "Blue is shallow."
  },
  {
   "i": 16,
   "start": 58.625,
   "speechStart": 58.625,
   "end": 60.475,
   "builds": 0,
   "text": "Magenta matters."
  },
  {
   "i": 17,
   "start": 60.725,
   "speechStart": 60.725,
   "end": 63.1,
   "builds": 0,
   "text": "Treat doubtful hazards as real."
  },
  {
   "i": 18,
   "start": 63.35,
   "speechStart": 63.35,
   "end": 65.0,
   "builds": 0,
   "text": "And zoom in."
  },
  {
   "i": 19,
   "start": 65.25,
   "speechStart": 65.25,
   "end": 67.375,
   "builds": 0,
   "text": "Next time: buoys."
  }
 ]
}
