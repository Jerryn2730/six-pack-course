 "sentences": [
  {
   "i": 0,
   "start": 0.15,
   "speechStart": 0.15,
   "end": 1.85,
   "builds": 0,
   "text": "Now let’s set it."
  },
  {
   "i": 1,
   "start": 2.1,
   "speechStart": 2.1,
   "end": 4.525,
   "builds": 0,
   "text": "Do it the same way every time."
  },
  {
   "i": 2,
   "start": 4.775,
   "speechStart": 4.775,
   "end": 12.9,
   "builds": 1,
   "text": "Choose your spot: good holding bottom, shelter from the wind you expect, and room to swing a full circle without hitting anything."
  },
  {
   "i": 3,
   "start": 13.15,
   "speechStart": 13.15,
   "end": 18.7,
   "builds": 1,
   "text": "Head slowly into the wind or current, whichever is stronger, and stop over the spot."
  },
  {
   "i": 4,
   "start": 18.95,
   "speechStart": 18.95,
   "end": 21.125,
   "builds": 1,
   "text": "Lower the anchor to the bottom."
  },
  {
   "i": 5,
   "start": 21.375,
   "speechStart": 21.375,
   "end": 23.15,
   "builds": 0,
   "text": "Never throw it."
  },
  {
   "i": 6,
   "start": 23.4,
   "speechStart": 23.4,
   "end": 24.95,
   "builds": 0,
   "text": "Why not?"
  },
  {
   "i": 7,
   "start": 25.2,
   "speechStart": 25.95,
   "end": 30.625,
   "builds": 0,
   "text": "A thrown anchor lands in a pile of its own rode and fouls itself."
  },
  {
   "i": 8,
   "start": 30.875,
   "speechStart": 30.875,
   "end": 35.275,
   "builds": 1,
   "text": "Let the boat drift back, or back down slowly, as you pay out your scope."
  },
  {
   "i": 9,
   "start": 35.525,
   "speechStart": 35.525,
   "end": 40.225,
   "builds": 1,
   "text": "Then snub the line, let the anchor bite, and set it with gentle reverse."
  },
  {
   "i": 10,
   "start": 40.475,
   "speechStart": 40.475,
   "end": 42.55,
   "builds": 0,
   "text": "And you’re still not finished."
  },
  {
   "i": 11,
   "start": 42.8,
   "speechStart": 42.8,
   "end": 47.175,
   "builds": 0,
   "text": "Take bearings on two landmarks, or set a GPS anchor alarm."
  },
  {
   "i": 12,
   "start": 47.425,
   "speechStart": 47.425,
   "end": 50.175,
   "builds": 0,
   "text": "That’s how you’ll know if she starts to move."
  }
 ]
}
