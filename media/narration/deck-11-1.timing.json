 "sentences": [
  {
   "i": 0,
   "start": 0.15,
   "speechStart": 0.15,
   "end": 5.525,
   "builds": 0,
   "text": "A passenger leans over the rail to see a fish, the boat lurches, and he’s gone."
  },
  {
   "i": 1,
   "start": 5.775,
   "speechStart": 5.775,
   "end": 9.725,
   "builds": 0,
   "text": "What you do in the next ten seconds decides how this ends."
  },
  {
   "i": 2,
   "start": 9.975,
   "speechStart": 9.975,
   "end": 12.125,
   "builds": 0,
   "text": "So let’s make it automatic."
  },
  {
   "i": 3,
   "start": 12.375,
   "speechStart": 12.375,
   "end": 15.975,
   "builds": 1,
   "text": "Shout man overboard, point at him, and keep pointing."
  },
  {
   "i": 4,
   "start": 16.225,
   "speechStart": 16.225,
   "end": 18.375,
   "builds": 1,
   "text": "Throw flotation right now."
  },
  {
   "i": 5,
   "start": 18.625,
   "speechStart": 18.625,
   "end": 21.9,
   "builds": 0,
   "text": "A ring buoy, a cushion, anything that floats."
  },
  {
   "i": 6,
   "start": 22.15,
   "speechStart": 22.15,
   "end": 25.625,
   "builds": 0,
   "text": "It gives him something to hold, and it marks the spot."
  },
  {
   "i": 7,
   "start": 25.875,
   "speechStart": 25.875,
   "end": 28.9,
   "builds": 1,
   "text": "Hit the man overboard button on the GPS."
  },
  {
   "i": 8,
   "start": 29.15,
   "speechStart": 29.15,
   "end": 31.875,
   "builds": 1,
   "text": "Turn the boat toward the side he fell from."
  },
  {
   "i": 9,
   "start": 32.125,
   "speechStart": 32.125,
   "end": 33.75,
   "builds": 0,
   "text": "Why toward him?"
  },
  {
   "i": 10,
   "start": 34.0,
   "speechStart": 34.75,
   "end": 39.675,
   "builds": 0,
   "text": "Because turning toward him swings your stern, and your propellers, away from him."
  },
  {
   "i": 11,
   "start": 39.925,
   "speechStart": 39.925,
   "end": 46.275,
   "builds": 1,
   "text": "And give one person a single job: eyes and arm on the man in the water, and never look away."
  },
  {
   "i": 12,
   "start": 46.525,
   "speechStart": 46.525,
   "end": 53.0,
   "builds": 0,
   "text": "A head in the waves disappears in seconds, and once you’ve lost sight of him, you may not find him again."
  }
 ]
}
