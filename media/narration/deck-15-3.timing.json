 "voice": "af_heart",
 "speed": 0.97,
 "buildCount": 5,
 "sentences": [
  {
   "i": 0,
   "start": 0.15,
   "speechStart": 0.15,
   "end": 5.45,
   "builds": 0,
   "text": "Florida’s waterways are full of drawbridges, and they have a little language of their own."
  },
  {
   "i": 1,
   "start": 5.7,
   "speechStart": 5.7,
   "end": 10.525,
   "builds": 1,
   "text": "To ask for an opening, sound one prolonged blast followed by one short."
  },
  {
   "i": 2,
   "start": 10.775,
   "speechStart": 10.775,
   "end": 13.6,
   "builds": 0,
   "text": "Or just call the bridge tender on the radio."
  },
  {
   "i": 3,
   "start": 13.85,
   "speechStart": 13.85,
   "end": 17.975,
   "builds": 1,
   "text": "In Florida, most bridges monitor VHF channel nine."
  },
  {
   "i": 4,
   "start": 18.225,
   "speechStart": 18.225,
   "end": 24.375,
   "builds": 1,
   "text": "If the bridge is going to open, it answers with the same signal: one prolonged and one short."
  },
  {
   "i": 5,
   "start": 24.625,
   "speechStart": 24.625,
   "end": 26.925,
   "builds": 1,
   "text": "And if it can’t open right now?"
  },
  {
   "i": 6,
   "start": 27.175,
   "speechStart": 27.925,
   "end": 29.875,
   "builds": 0,
   "text": "Five short blasts."
  },
  {
   "i": 7,
   "start": 30.125,
   "speechStart": 30.125,
   "end": 31.85,
   "builds": 0,
   "text": "Sound familiar?"
  },
  {
   "i": 8,
   "start": 32.1,
   "speechStart": 32.1,
   "end": 34.1,
   "builds": 0,
   "text": "It’s the danger signal."
  },
  {
   "i": 9,
   "start": 34.35,
   "speechStart": 34.35,
   "end": 36.425,
   "builds": 0,
   "text": "It means, don’t come ahead."
  },
  {
   "i": 10,
   "start": 36.675,
   "speechStart": 36.675,
   "end": 41.475,
   "builds": 1,
   "text": "Many bridges only open on a schedule, say on the hour and the half hour."
  },
  {
   "i": 11,
   "start": 41.725,
   "speechStart": 41.725,
   "end": 48.0,
   "builds": 0,
   "text": "The schedules are in the federal regulations and in the Coast Pilot, so look them up before you go."
  },
  {
   "i": 12,
   "start": 48.25,
   "speechStart": 48.25,
   "end": 51.65,
   "builds": 0,
   "text": "And hold well back until the span is fully open."
  },
  {
   "i": 13,
   "start": 51.9,
   "speechStart": 51.9,
   "end": 56.4,
   "builds": 0,
   "text": "A current can carry you into a half-open bridge faster than you’d believe."
  }
 ]
}
