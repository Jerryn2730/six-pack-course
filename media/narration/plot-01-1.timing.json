   "end": 2.275,
   "builds": 0,
   "text": "Welcome to Chart Plotting."
  },
  {
   "i": 1,
   "start": 2.525,
   "speechStart": 2.525,
   "end": 5.35,
   "builds": 0,
   "text": "This is the module you do with your hands."
  },
  {
   "i": 2,
   "start": 5.6,
   "speechStart": 5.6,
   "end": 7.85,
   "builds": 0,
   "text": "No memorizing rhymes here."
  },
  {
   "i": 3,
   "start": 8.1,
   "speechStart": 8.1,
   "end": 14.9,
   "builds": 0,
   "text": "You’ll draw lines on a real chart and measure them, and the exam checks whether your lines land in the right place."
  },
  {
   "i": 4,
   "start": 15.15,
   "speechStart": 15.15,
   "end": 16.825,
   "builds": 0,
   "text": "First, the kit."
  },
  {
   "i": 5,
   "start": 17.075,
   "speechStart": 17.075,
   "end": 20.7,
   "builds": 1,
   "text": "Parallel rulers, or a course plotter, for directions."
  },
  {
   "i": 6,
   "start": 20.95,
   "speechStart": 20.95,
   "end": 23.55,
   "builds": 1,
   "text": "A pair of dividers, for distances."
  },
  {
   "i": 7,
   "start": 23.8,
   "speechStart": 23.8,
   "end": 29.525,
   "builds": 1,
   "text": "Sharp pencils, a good eraser, and a simple calculator if your exam allows one."
  },
  {
   "i": 8,
   "start": 29.775,
   "speechStart": 29.775,
   "end": 31.625,
   "builds": 1,
   "text": "And the chart itself."
  },
  {
   "i": 9,
   "start": 31.875,
   "speechStart": 31.875,
   "end": 36.975,
   "builds": 0,
   "text": "The exam is usually worked on NOAA training chart twelve ten T R."
  },
  {
   "i": 10,
   "start": 37.225,
   "speechStart": 37.225,
   "end": 41.625,
   "builds": 0,
   "text": "It covers Martha’s Vineyard to Block Island, up in New England."
  },
  {
   "i": 11,
   "start": 41.875,
   "speechStart": 41.875,
   "end": 45.5,
   "builds": 0,
   "text": "A Florida captain, tested on a Massachusetts chart?"
  },
  {
   "i": 12,
   "start": 45.75,
   "speechStart": 46.5,
   "end": 47.9,
   "builds": 0,
   "text": "Yes."
  },
  {
   "i": 13,
   "start": 48.15,
   "speechStart": 48.15,
   "end": 51.325,
   "builds": 0,
   "text": "Everyone in the country uses the same one."
  },
  {
   "i": 14,
   "start": 51.575,
   "speechStart": 51.575,
   "end": 53.275,
   "builds": 0,
   "text": "So buy it now."
  },
  {
   "i": 15,
   "start": 53.525,
   "speechStart": 53.525,
   "end": 60.5,
   "builds": 1,
   "text": "And practice with the very tools you’ll carry into the exam room, so your hands already know them on test day."
  }
 ]
