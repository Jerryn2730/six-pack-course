   "builds": 0,
   "text": "Let’s run a DR track with a course change in it."
  },
  {
   "i": 1,
   "start": 3.625,
   "speechStart": 3.625,
   "end": 5.475,
   "builds": 0,
   "text": "Follow the diagram."
  },
  {
   "i": 2,
   "start": 5.725,
   "speechStart": 5.725,
   "end": 10.45,
   "builds": 1,
   "text": "You leave an eight hundred fix on course one two five true, at ten knots."
  },
  {
   "i": 3,
   "start": 10.7,
   "speechStart": 10.7,
   "end": 13.325,
   "builds": 1,
   "text": "At nine hundred, plot a DR."
  },
  {
   "i": 4,
   "start": 13.575,
   "speechStart": 13.575,
   "end": 17.975,
   "builds": 0,
   "text": "One hour at ten knots puts it ten miles along one two five."
  },
  {
   "i": 5,
   "start": 18.225,
   "speechStart": 18.225,
   "end": 20.625,
   "builds": 1,
   "text": "At nine thirty you change course."
  },
  {
   "i": 6,
   "start": 20.875,
   "speechStart": 20.875,
   "end": 24.075,
   "builds": 0,
   "text": "A change of course means a DR at that moment."
  },
  {
   "i": 7,
   "start": 24.325,
   "speechStart": 24.325,
   "end": 26.95,
   "builds": 0,
   "text": "How far from the nine hundred DR?"
  },
  {
   "i": 8,
   "start": 27.2,
   "speechStart": 27.95,
   "end": 32.625,
   "builds": 0,
   "text": "Half an hour at ten knots: five miles further along one two five."
  },
  {
   "i": 9,
   "start": 32.875,
   "speechStart": 32.875,
   "end": 37.9,
   "builds": 1,
   "text": "From that nine thirty DR, draw the new course line at one six zero true."
  },
  {
   "i": 10,
   "start": 38.15,
   "speechStart": 38.15,
   "end": 41.975,
   "builds": 0,
   "text": "At ten hundred, plot a DR five miles along it."
  },
  {
   "i": 11,
   "start": 42.225,
   "speechStart": 42.225,
   "end": 45.15,
   "builds": 1,
   "text": "And label every position with its time."
  },
  {
   "i": 12,
   "start": 45.4,
   "speechStart": 45.4,
   "end": 49.15,
   "builds": 0,
   "text": "If a fix comes in at any point, start a fresh track from it."
