# Netlify response headers (Task 4). Not served as a file.
/*
  X-Robots-Tag: noindex, nofollow
  X-Content-Type-Options: nosniff
  Referrer-Policy: same-origin

# The app page: always revalidate so content updates show up at once.
/
  Cache-Control: public, max-age=0, must-revalidate
/index.html
  Cache-Control: public, max-age=0, must-revalidate

# Narration MP3s and their timing files: cache for a day (they change only when a slide is re-narrated).
/audio/*
  Cache-Control: public, max-age=86400
/sw.js
  Cache-Control: max-age=0, must-revalidate
