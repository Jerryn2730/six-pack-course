 "voice": "af_heart",
 "speed": 0.97,
 "buildCount": 5,
 "sentences": [
  {
   "i": 0,
   "start": 0.15,
   "speechStart": 0.15,
   "end": 2.85,
   "builds": 0,
   "text": "Now, how does a boat actually steer?"
  },
  {
   "i": 1,
   "start": 3.1,
   "speechStart": 3.1,
   "end": 9.35,
   "builds": 1,
   "text": "An inboard boat steers by water flowing past the rudder, and most of that flow is prop wash."
  },
  {
   "i": 2,
   "start": 9.6,
   "speechStart": 9.6,
   "end": 12.65,
   "builds": 1,
   "text": "So when there’s little flow, there’s little steering."
  },
  {
   "i": 3,
   "start": 12.9,
   "speechStart": 12.9,
   "end": 15.1,
   "builds": 0,
   "text": "Dead slow, she’s sluggish."
  },
  {
   "i": 4,
   "start": 15.35,
   "speechStart": 15.35,
   "end": 18.15,
   "builds": 0,
   "text": "In reverse, she barely answers at all."
  },
  {
   "i": 5,
   "start": 18.4,
   "speechStart": 18.4,
   "end": 22.725,
   "builds": 1,
   "text": "The cure is a short burst of power with the rudder already over."
  },
  {
   "i": 6,
   "start": 22.975,
   "speechStart": 22.975,
   "end": 29.4,
   "builds": 0,
   "text": "That throws a slug of water against the rudder and kicks the stern across, without building much speed."
  },
  {
   "i": 7,
   "start": 29.65,
   "speechStart": 29.65,
   "end": 32.225,
   "builds": 1,
   "text": "And here’s the thing that catches people."
  },
  {
   "i": 8,
   "start": 32.475,
   "speechStart": 32.475,
   "end": 34.725,
   "builds": 0,
   "text": "A boat doesn’t turn like a car."
  },
  {
   "i": 9,
   "start": 34.975,
   "speechStart": 34.975,
   "end": 40.375,
   "builds": 0,
   "text": "Going ahead, she pivots about a point roughly a third of her length back from the bow."
  },
  {
   "i": 10,
   "start": 40.625,
   "speechStart": 40.625,
   "end": 42.7,
   "builds": 0,
   "text": "So which end swings wide?"
  },
  {
   "i": 11,
   "start": 42.95,
   "speechStart": 43.7,
   "end": 45.3,
   "builds": 0,
   "text": "The stern."
  },
  {
   "i": 12,
   "start": 45.55,
   "speechStart": 45.55,
   "end": 49.725,
   "builds": 0,
   "text": "Turn away from a dock too sharply, and your stern swings into it."
  },
  {
   "i": 13,
   "start": 49.975,
   "speechStart": 49.975,
   "end": 52.725,
   "builds": 1,
   "text": "Outboards and sterndrives are different."
  },
  {
   "i": 14,
   "start": 52.975,
   "speechStart": 52.975,
   "end": 58.225,
   "builds": 0,
   "text": "They steer by aiming the propeller’s thrust, so they answer well even at low speed."
  }
 ]
}
