 "voice": "af_heart",
 "speed": 0.97,
 "buildCount": 5,
 "sentences": [
  {
   "i": 0,
   "start": 0.15,
   "speechStart": 0.15,
   "end": 3.325,
   "builds": 0,
   "text": "Twenty miles offshore, you are the ambulance."
  },
  {
   "i": 1,
   "start": 3.575,
   "speechStart": 3.575,
   "end": 6.0,
   "builds": 0,
   "text": "Help may be an hour away or more."
  },
  {
   "i": 2,
   "start": 6.25,
   "speechStart": 6.25,
   "end": 11.975,
   "builds": 0,
   "text": "So first aid isn’t optional for a charter captain, and your license requires the training."
  },
  {
   "i": 3,
   "start": 12.225,
   "speechStart": 12.225,
   "end": 14.725,
   "builds": 0,
   "text": "Here are the priorities, in order."
  },
  {
   "i": 4,
   "start": 14.975,
   "speechStart": 14.975,
   "end": 17.1,
   "builds": 1,
   "text": "Make sure the scene is safe for you."
  },
  {
   "i": 5,
   "start": 17.35,
   "speechStart": 17.35,
   "end": 21.6,
   "builds": 0,
   "text": "Then check: does the person respond, and are they breathing normally?"
  },
  {
   "i": 6,
   "start": 21.85,
   "speechStart": 21.85,
   "end": 25.625,
   "builds": 1,
   "text": "Call for help early, on channel sixteen or by phone."
  },
  {
   "i": 7,
   "start": 25.875,
   "speechStart": 25.875,
   "end": 30.8,
   "builds": 0,
   "text": "The Coast Guard can put a doctor on the radio and arrange an evacuation."
  },
  {
   "i": 8,
   "start": 31.05,
   "speechStart": 31.05,
   "end": 33.5,
   "builds": 0,
   "text": "Don’t wait to see if it gets better."
  },
  {
   "i": 9,
   "start": 33.75,
   "speechStart": 33.75,
   "end": 37.05,
   "builds": 1,
   "text": "If they aren’t breathing normally, start CPR."
  },
  {
   "i": 10,
   "start": 37.3,
   "speechStart": 37.3,
   "end": 45.1,
   "builds": 0,
   "text": "Push hard and fast in the center of the chest: one hundred to one hundred twenty compressions a minute, about two inches deep."
  },
  {
   "i": 11,
   "start": 45.35,
   "speechStart": 45.35,
   "end": 47.2,
   "builds": 0,
   "text": "How fast is that?"
  },
  {
   "i": 12,
   "start": 47.45,
   "speechStart": 48.2,
   "end": 50.025,
   "builds": 0,
   "text": "About two a second."
  },
  {
   "i": 13,
   "start": 50.275,
   "speechStart": 50.275,
   "end": 52.7,
   "builds": 0,
   "text": "Faster than most people expect."
  },
  {
   "i": 14,
   "start": 52.95,
   "speechStart": 52.95,
   "end": 55.525,
   "builds": 1,
   "text": "Use an AED if you carry one."
  },
  {
   "i": 15,
   "start": 55.775,
   "speechStart": 55.775,
   "end": 58.35,
   "builds": 1,
   "text": "And keep your hands-on training current."
  },
  {
   "i": 16,
   "start": 58.6,
   "speechStart": 58.6,
   "end": 61.225,
   "builds": 0,
   "text": "You can’t learn CPR from a slide."
  }
 ]
}
