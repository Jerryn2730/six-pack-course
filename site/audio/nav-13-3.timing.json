 "sentences": [
  {
   "i": 0,
   "start": 0.15,
   "speechStart": 0.15,
   "end": 4.575,
   "builds": 0,
   "text": "You carry two free forecasting tools: a barometer, and the sky."
  },
  {
   "i": 1,
   "start": 4.825,
   "speechStart": 4.825,
   "end": 9.05,
   "builds": 1,
   "text": "A falling barometer means a low or a front is on its way."
  },
  {
   "i": 2,
   "start": 9.3,
   "speechStart": 9.3,
   "end": 12.45,
   "builds": 1,
   "text": "A rapid fall means strong wind, and soon."
  },
  {
   "i": 3,
   "start": 12.7,
   "speechStart": 12.7,
   "end": 15.975,
   "builds": 1,
   "text": "A rising barometer means improving weather."
  },
  {
   "i": 4,
   "start": 16.225,
   "speechStart": 16.225,
   "end": 17.8,
   "builds": 1,
   "text": "Now look up."
  },
  {
   "i": 5,
   "start": 18.05,
   "speechStart": 18.05,
   "end": 25.55,
   "builds": 0,
   "text": "High, thin, wispy cirrus that thickens and lowers over several hours usually means a warm front is coming."
  },
  {
   "i": 6,
   "start": 25.8,
   "speechStart": 25.8,
   "end": 31.4,
   "builds": 1,
   "text": "Towering cumulus, the tall cauliflower clouds, growing into a flat anvil top?"
  },
  {
   "i": 7,
   "start": 31.65,
   "speechStart": 32.4,
   "end": 34.1,
   "builds": 0,
   "text": "Thunderstorms."
  },
  {
   "i": 8,
   "start": 34.35,
   "speechStart": 34.35,
   "end": 38.025,
   "builds": 0,
   "text": "In a Florida summer, that’s your signal to start home."
  },
  {
   "i": 9,
   "start": 38.275,
   "speechStart": 38.275,
   "end": 40.475,
   "builds": 1,
   "text": "And a trick for finding the low."
  },
  {
   "i": 10,
   "start": 40.725,
   "speechStart": 40.725,
   "end": 43.025,
   "builds": 0,
   "text": "It’s called Buys Ballot’s law."
  },
  {
   "i": 11,
   "start": 43.275,
   "speechStart": 43.275,
   "end": 49.25,
   "builds": 0,
   "text": "In the Northern Hemisphere, stand with your back to the wind, and the low pressure is on your left."
  }
 ]
}
