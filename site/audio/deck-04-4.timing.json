 "audio": "deck-04-4.mp3",
 "duration": 56.5,
 "voice": "af_heart",
 "speed": 0.97,
 "buildCount": 5,
 "sentences": [
  {
   "i": 0,
   "start": 0.15,
   "speechStart": 0.15,
   "end": 4.85,
   "builds": 0,
   "text": "Electrical systems start a great many boat fires, so a few rules."
  },
  {
   "i": 1,
   "start": 5.1,
   "speechStart": 5.1,
   "end": 10.35,
   "builds": 1,
   "text": "Batteries give off hydrogen gas while they charge, and hydrogen is explosive."
  },
  {
   "i": 2,
   "start": 10.6,
   "speechStart": 10.6,
   "end": 13.65,
   "builds": 1,
   "text": "So battery compartments need ventilation."
  },
  {
   "i": 3,
   "start": 13.9,
   "speechStart": 13.9,
   "end": 19.375,
   "builds": 0,
   "text": "The batteries must be secured so they can’t shift in a seaway, with the terminals covered."
  },
  {
   "i": 4,
   "start": 19.625,
   "speechStart": 19.625,
   "end": 23.275,
   "builds": 1,
   "text": "Use marine-rated wiring, breakers and fuses."
  },
  {
   "i": 5,
   "start": 23.525,
   "speechStart": 23.525,
   "end": 26.3,
   "builds": 0,
   "text": "Household parts corrode and overheat."
  },
  {
   "i": 6,
   "start": 26.55,
   "speechStart": 26.55,
   "end": 29.525,
   "builds": 1,
   "text": "Check your shore power cords and connectors."
  },
  {
   "i": 7,
   "start": 29.775,
   "speechStart": 29.775,
   "end": 34.725,
   "builds": 0,
   "text": "Brown or melted plastic means heat, and heat means a fire on its way."
  },
  {
   "i": 8,
   "start": 34.975,
   "speechStart": 34.975,
   "end": 40.05,
   "builds": 1,
   "text": "And one danger most people have never heard of: electric shock drowning."
  },
  {
   "i": 9,
   "start": 40.3,
   "speechStart": 40.3,
   "end": 46.95,
   "builds": 0,
   "text": "Faulty wiring can put current into the water around a dock, especially in fresh or brackish water."
  },
  {
   "i": 10,
   "start": 47.2,
   "speechStart": 47.2,
   "end": 49.875,
   "builds": 0,
   "text": "A swimmer is paralyzed and drowns."
  },
  {
   "i": 11,
   "start": 50.125,
   "speechStart": 50.125,
   "end": 53.275,
   "builds": 0,
   "text": "So what’s the rule at any marina with shore power?"
  },
  {
   "i": 12,
   "start": 53.525,
   "speechStart": 54.275,
   "end": 56.2,
   "builds": 0,
   "text": "Nobody swims there."
  }
 ]
}
