 "sentences": [
  {
   "i": 0,
   "start": 0.15,
   "speechStart": 0.15,
   "end": 6.5,
   "builds": 0,
   "text": "In Florida, the sun injures more charter customers than anything else, so learn to tell these apart."
  },
  {
   "i": 1,
   "start": 6.75,
   "speechStart": 6.75,
   "end": 11.575,
   "builds": 1,
   "text": "Heat exhaustion: pale, cool, sweaty skin, with weakness and nausea."
  },
  {
   "i": 2,
   "start": 11.825,
   "speechStart": 11.825,
   "end": 15.95,
   "builds": 0,
   "text": "Get them into shade, cool them, give fluids, and let them rest."
  },
  {
   "i": 3,
   "start": 16.2,
   "speechStart": 16.2,
   "end": 18.7,
   "builds": 1,
   "text": "Heat stroke is a different animal."
  },
  {
   "i": 4,
   "start": 18.95,
   "speechStart": 18.95,
   "end": 21.675,
   "builds": 0,
   "text": "Hot skin, confusion, or collapse."
  },
  {
   "i": 5,
   "start": 21.925,
   "speechStart": 21.925,
   "end": 24.25,
   "builds": 0,
   "text": "So what’s the difference you look for?"
  },
  {
   "i": 6,
   "start": 24.5,
   "speechStart": 25.25,
   "end": 27.125,
   "builds": 0,
   "text": "The skin and the mind."
  },
  {
   "i": 7,
   "start": 27.375,
   "speechStart": 27.375,
   "end": 29.7,
   "builds": 0,
   "text": "Cool and sweaty is exhaustion."
  },
  {
   "i": 8,
   "start": 29.95,
   "speechStart": 29.95,
   "end": 34.075,
   "builds": 0,
   "text": "Hot and confused is stroke, and stroke is an emergency."
  },
  {
   "i": 9,
   "start": 34.325,
   "speechStart": 34.325,
   "end": 38.725,
   "builds": 0,
   "text": "Cool them hard with water and fanning, and call for help immediately."
  },
  {
   "i": 10,
   "start": 38.975,
   "speechStart": 38.975,
   "end": 42.875,
   "builds": 1,
   "text": "Hypothermia happens here too, after time in the water."
  },
  {
   "i": 11,
   "start": 43.125,
   "speechStart": 43.125,
   "end": 47.875,
   "builds": 0,
   "text": "Take off the wet clothes, insulate the person, and warm the core gently."
  },
  {
   "i": 12,
   "start": 48.125,
   "speechStart": 48.125,
   "end": 51.525,
   "builds": 0,
   "text": "Don’t rub the arms and legs, and no alcohol."
  },
  {
   "i": 13,
   "start": 51.775,
   "speechStart": 51.775,
   "end": 58.925,
   "builds": 1,
   "text": "And prevention beats all of it: shade, sunscreen, and plenty of water, starting before anyone feels thirsty."
  }
 ]
}
