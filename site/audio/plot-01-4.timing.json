 "sentences": [
  {
   "i": 0,
   "start": 0.15,
   "speechStart": 0.15,
   "end": 4.7,
   "builds": 0,
   "text": "The second skill is measuring distance, and the tool is your dividers."
  },
  {
   "i": 1,
   "start": 4.95,
   "speechStart": 4.95,
   "end": 6.775,
   "builds": 0,
   "text": "Look at the diagram."
  },
  {
   "i": 2,
   "start": 7.025,
   "speechStart": 7.025,
   "end": 11.325,
   "builds": 0,
   "text": "Open the dividers so one point sits on each end of your line."
  },
  {
   "i": 3,
   "start": 11.575,
   "speechStart": 11.575,
   "end": 17.5,
   "builds": 0,
   "text": "Then carry them, without changing the opening, to the latitude scale on the side of the chart."
  },
  {
   "i": 4,
   "start": 17.75,
   "speechStart": 17.75,
   "end": 20.6,
   "builds": 0,
   "text": "Read the minutes and tenths between the points."
  },
  {
   "i": 5,
   "start": 20.85,
   "speechStart": 20.85,
   "end": 27.375,
   "builds": 0,
   "text": "One minute of latitude is one nautical mile, so five point three minutes is five point three miles."
  },
  {
   "i": 6,
   "start": 27.625,
   "speechStart": 27.625,
   "end": 29.325,
   "builds": 0,
   "text": "Two cautions."
  },
  {
   "i": 7,
   "start": 29.575,
   "speechStart": 29.575,
   "end": 33.075,
   "builds": 0,
   "text": "First, the Mercator chart stretches as you go north."
  },
  {
   "i": 8,
   "start": 33.325,
   "speechStart": 33.325,
   "end": 36.025,
   "builds": 0,
   "text": "So where on the side scale do you measure?"
  },
  {
   "i": 9,
   "start": 36.275,
   "speechStart": 37.025,
   "end": 38.825,
   "builds": 0,
   "text": "Level with your work."
  },
  {
   "i": 10,
   "start": 39.075,
   "speechStart": 39.075,
   "end": 42.275,
   "builds": 0,
   "text": "Not at the top of the chart, and not at the bottom."
  },
  {
   "i": 11,
   "start": 42.525,
   "speechStart": 42.525,
   "end": 46.35,
   "builds": 0,
   "text": "Second, never use the scale across the top or bottom."
  },
  {
   "i": 12,
   "start": 46.6,
   "speechStart": 46.6,
   "end": 50.525,
   "builds": 0,
   "text": "That’s longitude, and a minute of longitude isn’t a mile."
  }
 ]
}
