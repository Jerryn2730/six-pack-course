   "i": 9,
   "start": 23.125,
   "speechStart": 23.125,
   "end": 27.375,
   "builds": 0,
   "text": "From the end of that line, swing ten miles until you hit the track."
  },
  {
   "i": 10,
   "start": 27.625,
   "speechStart": 27.625,
   "end": 33.2,
   "builds": 0,
   "text": "Before we measure it, which way do you expect to steer: north of east, or south of east?"
