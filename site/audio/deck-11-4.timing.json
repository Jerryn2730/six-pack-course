 "buildCount": 5,
 "sentences": [
  {
   "i": 0,
   "start": 0.15,
   "speechStart": 0.15,
   "end": 2.175,
   "builds": 0,
   "text": "What if it’s you in the water?"
  },
  {
   "i": 1,
   "start": 2.425,
   "speechStart": 2.425,
   "end": 4.5,
   "builds": 0,
   "text": "Here’s what keeps you alive."
  },
  {
   "i": 2,
   "start": 4.75,
   "speechStart": 4.75,
   "end": 6.9,
   "builds": 1,
   "text": "First, a life jacket."
  },
  {
   "i": 3,
   "start": 7.15,
   "speechStart": 7.15,
   "end": 12.725,
   "builds": 0,
   "text": "It’s the difference between living and drowning, and you can’t put one on after you’ve gone in."
  },
  {
   "i": 4,
   "start": 12.975,
   "speechStart": 12.975,
   "end": 16.05,
   "builds": 1,
   "text": "Second, a rule called one, ten, one."
  },
  {
   "i": 5,
   "start": 16.3,
   "speechStart": 16.3,
   "end": 20.9,
   "builds": 0,
   "text": "One minute of cold shock, when you gasp and can’t control your breathing."
  },
  {
   "i": 6,
   "start": 21.15,
   "speechStart": 21.15,
   "end": 24.9,
   "builds": 0,
   "text": "Ten minutes of useful movement, before your muscles quit."
  },
  {
   "i": 7,
   "start": 25.15,
   "speechStart": 25.15,
   "end": 29.15,
   "builds": 0,
   "text": "And about one hour before hypothermia makes you unconscious."
  },
  {
   "i": 8,
   "start": 29.4,
   "speechStart": 29.4,
   "end": 32.375,
   "builds": 0,
   "text": "What does that tell you to do in the first minute?"
  },
  {
   "i": 9,
   "start": 32.625,
   "speechStart": 33.375,
   "end": 34.875,
   "builds": 0,
   "text": "Nothing."
  },
  {
   "i": 10,
   "start": 35.125,
   "speechStart": 35.125,
   "end": 37.65,
   "builds": 0,
   "text": "Just float and get your breathing back."
  },
  {
   "i": 11,
   "start": 37.9,
   "speechStart": 37.9,
   "end": 42.9,
   "builds": 0,
   "text": "Florida’s water is warmer, which buys time, but not unlimited time."
  },
  {
   "i": 12,
   "start": 43.15,
   "speechStart": 43.15,
   "end": 47.875,
   "builds": 1,
   "text": "If you’re alone, take the HELP position: knees to your chest, arms crossed."
  },
  {
   "i": 13,
   "start": 48.125,
   "speechStart": 48.125,
   "end": 50.325,
   "builds": 1,
   "text": "In a group, huddle together."
  },
  {
   "i": 14,
   "start": 50.575,
   "speechStart": 50.575,
   "end": 52.9,
   "builds": 1,
   "text": "And stay with the boat if it floats."
  },
  {
   "i": 15,
   "start": 53.15,
   "speechStart": 53.15,
   "end": 55.4,
   "builds": 0,
   "text": "Don’t swim for a distant shore."
  },
  {
   "i": 16,
   "start": 55.65,
   "speechStart": 55.65,
   "end": 57.925,
   "builds": 0,
   "text": "It’s always farther than it looks."
  }
 ]
}
