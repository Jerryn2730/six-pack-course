 "sentences": [
  {
   "i": 0,
   "start": 0.15,
   "speechStart": 0.15,
   "end": 3.675,
   "builds": 0,
   "text": "Next, how the line is built, and how to keep it alive."
  },
  {
   "i": 1,
   "start": 3.925,
   "speechStart": 3.925,
   "end": 8.45,
   "builds": 1,
   "text": "Three-strand twisted line is easy to splice and stretches well."
  },
  {
   "i": 2,
   "start": 8.7,
   "speechStart": 8.7,
   "end": 10.875,
   "builds": 0,
   "text": "That suits an anchor rode."
  },
  {
   "i": 3,
   "start": 11.125,
   "speechStart": 11.125,
   "end": 16.15,
   "builds": 1,
   "text": "Double braid is strong and smooth, and kinder to your hands and your winches."
  },
  {
   "i": 4,
   "start": 16.4,
   "speechStart": 16.4,
   "end": 18.475,
   "builds": 0,
   "text": "That suits dock lines."
  },
  {
   "i": 5,
   "start": 18.725,
   "speechStart": 18.725,
   "end": 21.3,
   "builds": 1,
   "text": "The great enemy of any line is chafe."
  },
  {
   "i": 6,
   "start": 21.55,
   "speechStart": 21.55,
   "end": 27.125,
   "builds": 0,
   "text": "Wherever a line passes through a chock or bends over an edge, protect it with chafe gear."
  },
  {
   "i": 7,
   "start": 27.375,
   "speechStart": 27.375,
   "end": 31.625,
   "builds": 1,
   "text": "Rinse the salt out now and then, and store your lines out of the sun."
  },
  {
   "i": 8,
   "start": 31.875,
   "speechStart": 31.875,
   "end": 34.2,
   "builds": 1,
   "text": "And here’s the one for the exam."
  },
  {
   "i": 9,
   "start": 34.45,
   "speechStart": 34.45,
   "end": 37.925,
   "builds": 0,
   "text": "A knot weakens a line far more than a splice does."
  },
  {
   "i": 10,
   "start": 38.175,
   "speechStart": 38.175,
   "end": 39.65,
   "builds": 0,
   "text": "How much?"
  },
  {
   "i": 11,
   "start": 39.9,
   "speechStart": 40.65,
   "end": 43.825,
   "builds": 0,
   "text": "A knot can cost you a third of the strength or more."
  },
  {
   "i": 12,
   "start": 44.075,
   "speechStart": 44.075,
   "end": 46.375,
   "builds": 0,
   "text": "A good splice keeps most of it."
  },
  {
   "i": 13,
   "start": 46.625,
   "speechStart": 46.625,
   "end": 49.2,
   "builds": 0,
   "text": "So anything permanent gets spliced."
  }
 ]
}
