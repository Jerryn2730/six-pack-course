 "voice": "af_heart",
 "speed": 0.97,
 "buildCount": 5,
 "sentences": [
  {
   "i": 0,
   "start": 0.15,
   "speechStart": 0.15,
   "end": 5.225,
   "builds": 0,
   "text": "Each extinguishing agent suits certain fires, so match the agent to the class."
  },
  {
   "i": 1,
   "start": 5.475,
   "speechStart": 5.475,
   "end": 10.3,
   "builds": 1,
   "text": "Dry chemical, rated A B C or B C, is the one on most boats."
  },
  {
   "i": 2,
   "start": 10.55,
   "speechStart": 10.55,
   "end": 12.8,
   "builds": 0,
   "text": "It works on nearly everything."
  },
  {
   "i": 3,
   "start": 13.05,
   "speechStart": 13.05,
   "end": 16.5,
   "builds": 0,
   "text": "The price is a corrosive powder all over your boat."
  },
  {
   "i": 4,
   "start": 16.75,
   "speechStart": 16.75,
   "end": 22.625,
   "builds": 1,
   "text": "Carbon dioxide works on fuel and electrical fires by displacing the oxygen."
  },
  {
   "i": 5,
   "start": 22.875,
   "speechStart": 22.875,
   "end": 24.775,
   "builds": 0,
   "text": "It leaves no mess."
  },
  {
   "i": 6,
   "start": 25.025,
   "speechStart": 25.025,
   "end": 29.725,
   "builds": 0,
   "text": "But it has short range, and in a closed space it can suffocate you too."
  },
  {
   "i": 7,
   "start": 29.975,
   "speechStart": 29.975,
   "end": 34.875,
   "builds": 1,
   "text": "Clean agents are what you’ll usually find in a fixed engine-room system."
  },
  {
   "i": 8,
   "start": 35.125,
   "speechStart": 35.125,
   "end": 38.9,
   "builds": 1,
   "text": "Foam smothers fuel fires by floating on top of them."
  },
  {
   "i": 9,
   "start": 39.15,
   "speechStart": 39.15,
   "end": 40.625,
   "builds": 1,
   "text": "And water."
  },
  {
   "i": 10,
   "start": 40.875,
   "speechStart": 40.875,
   "end": 43.425,
   "builds": 0,
   "text": "It’s excellent on Class A fires."
  },
  {
   "i": 11,
   "start": 43.675,
   "speechStart": 43.675,
   "end": 48.45,
   "builds": 0,
   "text": "But what happens if you hit burning gasoline with a solid stream of water?"
  },
  {
   "i": 12,
   "start": 48.7,
   "speechStart": 49.45,
   "end": 51.075,
   "builds": 0,
   "text": "You spread it."
  },
  {
   "i": 13,
   "start": 51.325,
   "speechStart": 51.325,
   "end": 56.2,
   "builds": 0,
   "text": "And on live electrical gear, water conducts the current right back to you."
  },
  {
   "i": 14,
   "start": 56.45,
   "speechStart": 56.45,
   "end": 59.025,
   "builds": 0,
   "text": "So water is for Class A only."
  }
 ]
}
