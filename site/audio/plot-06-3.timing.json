 "sentences": [
  {
   "i": 0,
   "start": 0.15,
   "speechStart": 0.15,
   "end": 3.65,
   "builds": 0,
   "text": "Two lines always cross somewhere, right or wrong."
  },
  {
   "i": 1,
   "start": 3.9,
   "speechStart": 3.9,
   "end": 6.5,
   "builds": 0,
   "text": "So how do you know your fix is any good?"
  },
  {
   "i": 2,
   "start": 6.75,
   "speechStart": 6.75,
   "end": 8.75,
   "builds": 0,
   "text": "You take a third bearing."
  },
  {
   "i": 3,
   "start": 9.0,
   "speechStart": 9.0,
   "end": 10.825,
   "builds": 0,
   "text": "Look at the diagram."
  },
  {
   "i": 4,
   "start": 11.075,
   "speechStart": 11.075,
   "end": 15.925,
   "builds": 0,
   "text": "With real instruments, three lines almost never meet at one exact point."
  },
  {
   "i": 5,
   "start": 16.175,
   "speechStart": 16.175,
   "end": 19.3,
   "builds": 0,
   "text": "They make a small triangle, called a cocked hat."
  },
  {
   "i": 6,
   "start": 19.55,
   "speechStart": 19.55,
   "end": 21.75,
   "builds": 0,
   "text": "Put your fix in the middle of it."
  },
  {
   "i": 7,
   "start": 22.0,
   "speechStart": 22.0,
   "end": 24.15,
   "builds": 0,
   "text": "That triangle is honest."
  },
  {
   "i": 8,
   "start": 24.4,
   "speechStart": 24.4,
   "end": 26.925,
   "builds": 0,
   "text": "It’s showing you the size of your error."
  },
  {
   "i": 9,
   "start": 27.175,
   "speechStart": 27.175,
   "end": 29.4,
   "builds": 0,
   "text": "A small one means good bearings."
  },
  {
   "i": 10,
   "start": 29.65,
   "speechStart": 29.65,
   "end": 31.25,
   "builds": 0,
   "text": "And a big one?"
  },
  {
   "i": 11,
   "start": 31.5,
   "speechStart": 32.25,
   "end": 34.0,
   "builds": 0,
   "text": "Something’s wrong."
  },
  {
   "i": 12,
   "start": 34.25,
   "speechStart": 34.25,
   "end": 41.675,
   "builds": 0,
   "text": "You misidentified a landmark, or misread the compass, or drew a bearing from the wrong side, or forgot a correction."
  },
  {
   "i": 13,
   "start": 41.925,
   "speechStart": 41.925,
   "end": 44.3,
   "builds": 0,
   "text": "Don’t average a big triangle."
  },
  {
   "i": 14,
   "start": 44.55,
   "speechStart": 44.55,
   "end": 46.25,
   "builds": 0,
   "text": "Find the mistake."
  },
  {
   "i": 15,
   "start": 46.5,
   "speechStart": 46.5,
   "end": 51.675,
   "builds": 0,
   "text": "The ideal is three objects about one hundred twenty degrees apart, all around you."
  }
 ]
}
