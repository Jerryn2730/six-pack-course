 "speed": 0.97,
 "buildCount": 0,
 "sentences": [
  {
   "i": 0,
   "start": 0.15,
   "speechStart": 0.15,
   "end": 3.2,
   "builds": 0,
   "text": "At night a lighthouse doesn’t tell you its name."
  },
  {
   "i": 1,
   "start": 3.45,
   "speechStart": 3.45,
   "end": 6.225,
   "builds": 0,
   "text": "It tells you its rhythm, and you look it up."
  },
  {
   "i": 2,
   "start": 6.475,
   "speechStart": 6.475,
   "end": 9.5,
   "builds": 0,
   "text": "That rhythm is called the light’s characteristic."
  },
  {
   "i": 3,
   "start": 9.75,
   "speechStart": 9.75,
   "end": 11.975,
   "builds": 0,
   "text": "Look at the patterns on screen."
  },
  {
   "i": 4,
   "start": 12.225,
   "speechStart": 12.225,
   "end": 14.2,
   "builds": 0,
   "text": "Fixed is a steady light."
  },
  {
   "i": 5,
   "start": 14.45,
   "speechStart": 14.45,
   "end": 17.575,
   "builds": 0,
   "text": "Flashing means it’s dark longer than it’s lit."
  },
  {
   "i": 6,
   "start": 17.825,
   "speechStart": 17.825,
   "end": 20.6,
   "builds": 0,
   "text": "Quick is about sixty flashes a minute."
  },
  {
   "i": 7,
   "start": 20.85,
   "speechStart": 20.85,
   "end": 23.65,
   "builds": 0,
   "text": "Isophase means equal light and dark."
  },
  {
   "i": 8,
   "start": 23.9,
   "speechStart": 23.9,
   "end": 29.375,
   "builds": 0,
   "text": "Occulting is the reverse of flashing: lit longer than dark, with short eclipses."
  },
  {
   "i": 9,
   "start": 29.625,
   "speechStart": 29.625,
   "end": 32.725,
   "builds": 0,
   "text": "Group flashing shows its flashes in groups."
  },
  {
   "i": 10,
   "start": 32.975,
   "speechStart": 32.975,
   "end": 35.55,
   "builds": 0,
   "text": "And Morse A is a short and a long."
  },
  {
   "i": 11,
   "start": 35.8,
   "speechStart": 35.8,
   "end": 38.1,
   "builds": 0,
   "text": "Now read a chart label with me."
  },
  {
   "i": 12,
   "start": 38.35,
   "speechStart": 38.35,
   "end": 42.825,
   "builds": 0,
   "text": "F L two, white, ten seconds, forty-five feet, fourteen miles."
  },
  {
   "i": 13,
   "start": 43.075,
   "speechStart": 43.075,
   "end": 44.675,
   "builds": 0,
   "text": "What does it say?"
  },
  {
   "i": 14,
   "start": 44.925,
   "speechStart": 45.675,
   "end": 55.0,
   "builds": 0,
   "text": "A white light, flashing in groups of two, every ten seconds, forty-five feet above mean high water, with a nominal range of fourteen miles."
  },
  {
   "i": 15,
   "start": 55.25,
   "speechStart": 55.25,
   "end": 58.65,
   "builds": 0,
   "text": "So when you think you’ve found your light, time it with a watch."
  },
  {
   "i": 16,
   "start": 58.9,
   "speechStart": 58.9,
   "end": 61.325,
   "builds": 0,
   "text": "The period will tell you if you’re right."
  }
 ]
}
