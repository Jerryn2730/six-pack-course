   "start": 0.15,
   "speechStart": 0.15,
   "end": 4.95,
   "builds": 0,
   "text": "Dead reckoning has rules about when you plot, and the exam follows them."
  },
  {
   "i": 1,
   "start": 5.2,
   "speechStart": 5.2,
   "end": 7.95,
   "builds": 1,
   "text": "Plot a DR every hour, on the hour."
  },
  {
   "i": 2,
   "start": 8.2,
   "speechStart": 8.2,
   "end": 10.8,
   "builds": 1,
   "text": "At every change of course or speed."
  },
  {
   "i": 3,
   "start": 11.05,
   "speechStart": 11.05,
   "end": 14.05,
   "builds": 1,
   "text": "At the time of every fix or running fix."
  },
  {
   "i": 4,
   "start": 14.3,
   "speechStart": 14.3,
   "end": 17.775,
   "builds": 1,
   "text": "And at the time you get a single line of position."
  },
  {
   "i": 5,
   "start": 18.025,
   "speechStart": 18.025,
   "end": 20.225,
   "builds": 1,
   "text": "Then the most important rule."
  },
  {
   "i": 6,
   "start": 20.475,
   "speechStart": 20.475,
   "end": 24.125,
   "builds": 0,
   "text": "Whenever you get a fix, start a new DR track from it."
  },
  {
   "i": 7,
   "start": 24.375,
   "speechStart": 24.375,
   "end": 26.7,
   "builds": 0,
   "text": "Why throw away the old track?"
  },
  {
   "i": 8,
   "start": 26.95,
   "speechStart": 27.7,
   "end": 30.5,
   "builds": 0,
   "text": "Because the fix is better information."
  },
  {
   "i": 9,
   "start": 30.75,
   "speechStart": 30.75,
   "end": 37.6,
   "builds": 0,
   "text": "Your old DR has been collecting error since the last fix: current, wind, a helmsman who wandered."
  },
  {
   "i": 10,
   "start": 37.85,
   "speechStart": 37.85,
   "end": 40.1,
   "builds": 0,
   "text": "The fix wipes the slate clean."
  },
  {
   "i": 11,
   "start": 40.35,
   "speechStart": 40.35,
   "end": 46.2,
   "builds": 0,
   "text": "These rules come from Bowditch, the standard reference, so exam problems are built on them."
  }
 ]
}
