 "sentences": [
  {
   "i": 0,
   "start": 0.15,
   "speechStart": 0.15,
   "end": 5.65,
   "builds": 0,
   "text": "One more system, for waters you may never see but the exam still asks about."
  },
  {
   "i": 1,
   "start": 5.9,
   "speechStart": 5.9,
   "end": 7.8,
   "builds": 0,
   "text": "The Western Rivers."
  },
  {
   "i": 2,
   "start": 8.05,
   "speechStart": 8.05,
   "end": 11.0,
   "builds": 0,
   "text": "That’s the Mississippi and its tributaries."
  },
  {
   "i": 3,
   "start": 11.25,
   "speechStart": 11.25,
   "end": 14.925,
   "builds": 0,
   "text": "The marks there are a modified version of what you know."
  },
  {
   "i": 4,
   "start": 15.175,
   "speechStart": 15.175,
   "end": 17.15,
   "builds": 1,
   "text": "The buoys aren’t numbered."
  },
  {
   "i": 5,
   "start": 17.4,
   "speechStart": 17.4,
   "end": 18.95,
   "builds": 0,
   "text": "Why not?"
  },
  {
   "i": 6,
   "start": 19.2,
   "speechStart": 19.95,
   "end": 22.25,
   "builds": 0,
   "text": "Because the channel keeps moving."
  },
  {
   "i": 7,
   "start": 22.5,
   "speechStart": 22.5,
   "end": 28.225,
   "builds": 0,
   "text": "A river shifts its sandbars from one month to the next, and the buoys are moved to follow."
  },
  {
   "i": 8,
   "start": 28.475,
   "speechStart": 28.475,
   "end": 35.45,
   "builds": 1,
   "text": "Instead of numbers, there are mileage boards on the bank, showing the distance in statute miles from a fixed point."
  },
  {
   "i": 9,
   "start": 35.7,
   "speechStart": 35.7,
   "end": 38.2,
   "builds": 0,
   "text": "Statute miles, not nautical."
  },
  {
   "i": 10,
   "start": 38.45,
   "speechStart": 38.45,
   "end": 44.675,
   "builds": 1,
   "text": "Passing daymarks, red triangles and green squares, mark the side of the channel along a bank."
  },
  {
   "i": 11,
   "start": 44.925,
   "speechStart": 44.925,
   "end": 51.5,
   "builds": 1,
   "text": "And crossing daymarks, shaped like diamonds, show where the channel crosses from one bank to the other."
  }
 ]
}
