  {
   "i": 0,
   "start": 0.15,
   "speechStart": 0.15,
   "end": 3.3,
   "builds": 0,
   "text": "Next, the things that can put a hole in your boat."
  },
  {
   "i": 1,
   "start": 3.55,
   "speechStart": 3.55,
   "end": 5.325,
   "builds": 0,
   "text": "Go down the table."
  },
  {
   "i": 2,
   "start": 5.575,
   "speechStart": 5.575,
   "end": 9.175,
   "builds": 1,
   "text": "A rock that does not cover is always above water."
  },
  {
   "i": 3,
   "start": 9.425,
   "speechStart": 9.425,
   "end": 12.475,
   "builds": 0,
   "text": "Its height is given above mean high water."
  },
  {
   "i": 4,
   "start": 12.725,
   "speechStart": 12.725,
   "end": 17.825,
   "builds": 1,
   "text": "A rock that covers and uncovers shows at low tide and hides at high tide."
  },
  {
   "i": 5,
   "start": 18.075,
   "speechStart": 18.075,
   "end": 21.875,
   "builds": 1,
   "text": "A rock awash sits right at the surface at chart datum."
  },
  {
   "i": 6,
   "start": 22.125,
   "speechStart": 22.125,
   "end": 27.35,
   "builds": 1,
   "text": "A sunken rock, marked with a cross, is always under water, and may be dangerous."
  },
  {
   "i": 7,
   "start": 27.6,
   "speechStart": 27.6,
   "end": 33.575,
   "builds": 1,
   "text": "A wreck is drawn as a little hull if part of it shows, and as crossed lines if it’s submerged."
  },
  {
   "i": 8,
   "start": 33.825,
   "speechStart": 33.825,
   "end": 36.725,
   "builds": 1,
   "text": "O b s t n means an obstruction."
  },
  {
   "i": 9,
   "start": 36.975,
   "speechStart": 36.975,
   "end": 38.875,
   "builds": 1,
   "text": "And then the qualifiers."
  },
  {
   "i": 10,
   "start": 39.125,
   "speechStart": 39.125,
   "end": 41.65,
   "builds": 0,
   "text": "P A is position approximate."
  },
  {
   "i": 11,
   "start": 41.9,
   "speechStart": 41.9,
   "end": 44.35,
   "builds": 0,
   "text": "P D is position doubtful."
  },
  {
   "i": 12,
   "start": 44.6,
   "speechStart": 44.6,
   "end": 46.95,
   "builds": 0,
   "text": "E D is existence doubtful."
  },
  {
   "i": 13,
   "start": 47.2,
   "speechStart": 47.2,
   "end": 50.25,
   "builds": 0,
   "text": "Rep means reported, but not confirmed."
  },
  {
   "i": 14,
   "start": 50.5,
   "speechStart": 50.5,
   "end": 53.9,
   "builds": 0,
   "text": "So how do you treat a hazard marked existence doubtful?"
  },
  {
   "i": 15,
   "start": 54.15,
   "speechStart": 54.9,
   "end": 56.6,
   "builds": 0,
   "text": "As if it’s there."
  },
  {
   "i": 16,
   "start": 56.85,
   "speechStart": 56.85,
   "end": 60.675,
   "builds": 0,
   "text": "Every one of them is real until you’ve proved otherwise."
  }
 ]
