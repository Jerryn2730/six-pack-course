  {
   "i": 4,
   "start": 12.275,
   "speechStart": 12.275,
   "end": 17.725,
   "builds": 0,
   "text": "We’re going from true toward magnetic, which is uncorrecting, so we add west."
  },
  {
   "i": 5,
   "start": 17.975,
   "speechStart": 17.975,
   "end": 21.8,
   "builds": 0,
   "text": "Zero four two plus six is zero four eight, magnetic."
  },
  {
   "i": 6,
   "start": 22.05,
   "speechStart": 22.05,
   "end": 26.35,
   "builds": 1,
   "text": "You line up on the range, and your compass reads zero five one."
