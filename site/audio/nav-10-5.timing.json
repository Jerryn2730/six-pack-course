  {
   "i": 7,
   "start": 26.6,
   "speechStart": 26.6,
   "end": 29.825,
   "builds": 1,
   "text": "The compass reads three degrees more than magnetic."
  },
  {
   "i": 8,
   "start": 30.075,
   "speechStart": 30.075,
   "end": 32.85,
   "builds": 0,
   "text": "So is the deviation east or west?"
  },
  {
   "i": 9,
   "start": 33.1,
   "speechStart": 33.85,
   "end": 36.175,
   "builds": 0,
   "text": "Compass best, error west."
  },
  {
   "i": 10,
   "start": 36.425,
   "speechStart": 36.425,
   "end": 38.325,
   "builds": 0,
   "text": "Three degrees west."
  },
  {
   "i": 11,
   "start": 38.575,
   "speechStart": 38.575,
   "end": 41.675,
   "builds": 1,
   "text": "Write it on your deviation card for that heading."
