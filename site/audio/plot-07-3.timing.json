 "sentences": [
  {
   "i": 0,
   "start": 0.15,
   "speechStart": 0.15,
   "end": 3.45,
   "builds": 0,
   "text": "Three kinds of position, three levels of trust."
  },
  {
   "i": 1,
   "start": 3.7,
   "speechStart": 3.7,
   "end": 8.325,
   "builds": 1,
   "text": "A DR uses only the course you steered and your speed through the water."
  },
  {
   "i": 2,
   "start": 8.575,
   "speechStart": 8.575,
   "end": 10.5,
   "builds": 0,
   "text": "Nothing about current."
  },
  {
   "i": 3,
   "start": 10.75,
   "speechStart": 10.75,
   "end": 12.675,
   "builds": 0,
   "text": "Nothing about wind."
  },
  {
   "i": 4,
   "start": 12.925,
   "speechStart": 12.925,
   "end": 19.5,
   "builds": 1,
   "text": "An estimated position, an E P, starts with the DR and improves it with whatever else you know."
  },
  {
   "i": 5,
   "start": 19.75,
   "speechStart": 19.75,
   "end": 23.425,
   "builds": 0,
   "text": "A known current, say, or a single line of position."
  },
  {
   "i": 6,
   "start": 23.675,
   "speechStart": 23.675,
   "end": 25.425,
   "builds": 1,
   "text": "Here’s a neat case."
  },
  {
   "i": 7,
   "start": 25.675,
   "speechStart": 25.675,
   "end": 28.675,
   "builds": 0,
   "text": "You have one line of position and a DR."
  },
  {
   "i": 8,
   "start": 28.925,
   "speechStart": 28.925,
   "end": 30.75,
   "builds": 0,
   "text": "Where’s your E P?"
  },
  {
   "i": 9,
   "start": 31.0,
   "speechStart": 31.75,
   "end": 34.7,
   "builds": 0,
   "text": "The point on that line nearest your DR."
  },
  {
   "i": 10,
   "start": 34.95,
   "speechStart": 34.95,
   "end": 38.65,
   "builds": 0,
   "text": "You know you’re on the line, and that’s the best guess as to where."
  },
  {
   "i": 11,
   "start": 38.9,
   "speechStart": 38.9,
   "end": 43.275,
   "builds": 1,
   "text": "A fix is two or more good lines of position at the same time."
  },
  {
   "i": 12,
   "start": 43.525,
   "speechStart": 43.525,
   "end": 48.6,
   "builds": 1,
   "text": "So the ranking is: a fix beats an E P, and an E P beats a DR."
  }
 ]
}
