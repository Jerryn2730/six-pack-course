 "buildCount": 5,
 "sentences": [
  {
   "i": 0,
   "start": 0.15,
   "speechStart": 0.15,
   "end": 2.85,
   "builds": 0,
   "text": "So how do you get from a blip to a decision?"
  },
  {
   "i": 1,
   "start": 3.1,
   "speechStart": 3.1,
   "end": 4.625,
   "builds": 0,
   "text": "You plot it."
  },
  {
   "i": 2,
   "start": 4.875,
   "speechStart": 4.875,
   "end": 9.0,
   "builds": 1,
   "text": "Mark the target’s position several times, over a few minutes."
  },
  {
   "i": 3,
   "start": 9.25,
   "speechStart": 9.25,
   "end": 13.125,
   "builds": 1,
   "text": "The line through those marks is its relative motion line."
  },
  {
   "i": 4,
   "start": 13.375,
   "speechStart": 13.375,
   "end": 16.725,
   "builds": 0,
   "text": "That’s how the target is moving in relation to you."
  },
  {
   "i": 5,
   "start": 16.975,
   "speechStart": 16.975,
   "end": 20.05,
   "builds": 1,
   "text": "Extend that line past the center of the screen."
  },
  {
   "i": 6,
   "start": 20.3,
   "speechStart": 20.3,
   "end": 25.65,
   "builds": 0,
   "text": "The closest it comes to the center is the closest point of approach, the C P A."
  },
  {
   "i": 7,
   "start": 25.9,
   "speechStart": 25.9,
   "end": 28.725,
   "builds": 0,
   "text": "The time until then is the T C P A."
  },
  {
   "i": 8,
   "start": 28.975,
   "speechStart": 28.975,
   "end": 33.075,
   "builds": 0,
   "text": "So if the line runs straight through the center, what’s your C P A?"
  },
  {
   "i": 9,
   "start": 33.325,
   "speechStart": 34.075,
   "end": 35.475,
   "builds": 0,
   "text": "Zero."
  },
  {
   "i": 10,
   "start": 35.725,
   "speechStart": 35.725,
   "end": 37.7,
   "builds": 0,
   "text": "That’s a collision course."
  },
  {
   "i": 11,
   "start": 37.95,
   "speechStart": 37.95,
   "end": 40.8,
   "builds": 1,
   "text": "Many radars will track targets for you."
  },
  {
   "i": 12,
   "start": 41.05,
   "speechStart": 41.05,
   "end": 44.625,
   "builds": 0,
   "text": "On small boats it’s called MARPA, on ships ARPA."
  },
  {
   "i": 13,
   "start": 44.875,
   "speechStart": 44.875,
   "end": 47.825,
   "builds": 1,
   "text": "And Rule seven is behind all of this."
  },
  {
   "i": 14,
   "start": 48.075,
   "speechStart": 48.075,
   "end": 52.625,
   "builds": 0,
   "text": "Plotting, or equivalent systematic observation, is required."
  },
  {
   "i": 15,
   "start": 52.875,
   "speechStart": 52.875,
   "end": 56.275,
   "builds": 0,
   "text": "No decisions on scanty radar information."
  }
 ]
}
