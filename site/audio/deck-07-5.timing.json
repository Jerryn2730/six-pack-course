 "sentences": [
  {
   "i": 0,
   "start": 0.15,
   "speechStart": 0.15,
   "end": 3.75,
   "builds": 0,
   "text": "Wind and current decide which docking plan you use."
  },
  {
   "i": 1,
   "start": 4.0,
   "speechStart": 4.0,
   "end": 7.825,
   "builds": 1,
   "text": "If the wind is blowing onto the dock, it’s the easy one."
  },
  {
   "i": 2,
   "start": 8.075,
   "speechStart": 8.075,
   "end": 13.15,
   "builds": 0,
   "text": "Stop parallel, a few feet off, and let the wind set you gently alongside."
  },
  {
   "i": 3,
   "start": 13.4,
   "speechStart": 13.4,
   "end": 21.6,
   "builds": 1,
   "text": "If the wind is blowing off the dock, come in at a steeper angle, get a bow line or a spring on quickly, and use it to work her in."
  },
  {
   "i": 4,
   "start": 21.85,
   "speechStart": 21.85,
   "end": 24.825,
   "builds": 1,
   "text": "Current from ahead is the easiest of all."
  },
  {
   "i": 5,
   "start": 25.075,
   "speechStart": 25.075,
   "end": 30.15,
   "builds": 0,
   "text": "Current from astern is the hard one, because it’s pushing you faster than you think."
  },
  {
   "i": 6,
   "start": 30.4,
   "speechStart": 30.4,
   "end": 32.4,
   "builds": 0,
   "text": "What should you do if you can?"
  },
  {
   "i": 7,
   "start": 32.65,
   "speechStart": 33.4,
   "end": 36.05,
   "builds": 0,
   "text": "Turn around, and come in against it."
  },
  {
   "i": 8,
   "start": 36.3,
   "speechStart": 36.3,
   "end": 37.875,
   "builds": 1,
   "text": "And leaving."
  },
  {
   "i": 9,
   "start": 38.125,
   "speechStart": 38.125,
   "end": 43.0,
   "builds": 0,
   "text": "Motor gently ahead against a bow spring with the wheel turned toward the dock."
  },
  {
   "i": 10,
   "start": 43.25,
   "speechStart": 43.25,
   "end": 46.5,
   "builds": 0,
   "text": "The stern swings out, and then you back away clear."
  },
  {
   "i": 11,
   "start": 46.75,
   "speechStart": 46.75,
   "end": 48.675,
   "builds": 0,
   "text": "That’s lesson seven."
  },
  {
   "i": 12,
   "start": 48.925,
   "speechStart": 48.925,
   "end": 52.675,
   "builds": 0,
   "text": "Prop walk: a right-hand prop walks to port in reverse."
  },
  {
   "i": 13,
   "start": 52.925,
   "speechStart": 52.925,
   "end": 54.875,
   "builds": 0,
   "text": "The stern swings wide."
  },
  {
   "i": 14,
   "start": 55.125,
   "speechStart": 55.125,
   "end": 58.5,
   "builds": 0,
   "text": "Slow, into the wind or current, lines ready."
  },
  {
   "i": 15,
   "start": 58.75,
   "speechStart": 58.75,
   "end": 61.425,
   "builds": 0,
   "text": "Next time: the lines themselves."
  }
 ]
}
