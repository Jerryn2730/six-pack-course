 "voice": "af_heart",
 "speed": 0.97,
 "buildCount": 5,
 "sentences": [
  {
   "i": 0,
   "start": 0.15,
   "speechStart": 0.15,
   "end": 7.65,
   "builds": 0,
   "text": "Florida gets more lightning than any other state, and from June to September a thunderstorm is nearly a daily event."
  },
  {
   "i": 1,
   "start": 7.9,
   "speechStart": 7.9,
   "end": 12.175,
   "builds": 0,
   "text": "This lesson is about the weather that can kill you in an afternoon."
  },
  {
   "i": 2,
   "start": 12.425,
   "speechStart": 12.425,
   "end": 18.35,
   "builds": 1,
   "text": "Summer storms usually build over the land in the early afternoon, then drift toward the coast."
  },
  {
   "i": 3,
   "start": 18.6,
   "speechStart": 18.6,
   "end": 20.6,
   "builds": 0,
   "text": "So the morning is yours."
  },
  {
   "i": 4,
   "start": 20.85,
   "speechStart": 20.85,
   "end": 23.4,
   "builds": 0,
   "text": "The afternoon belongs to the storm."
  },
  {
   "i": 5,
   "start": 23.65,
   "speechStart": 23.65,
   "end": 27.2,
   "builds": 1,
   "text": "If you can hear thunder, you’re close enough to be struck."
  },
  {
   "i": 6,
   "start": 27.45,
   "speechStart": 27.45,
   "end": 29.15,
   "builds": 0,
   "text": "Head in early."
  },
  {
   "i": 7,
   "start": 29.4,
   "speechStart": 29.4,
   "end": 31.8,
   "builds": 1,
   "text": "The wind arrives before the rain."
  },
  {
   "i": 8,
   "start": 32.05,
   "speechStart": 32.05,
   "end": 36.375,
   "builds": 0,
   "text": "Gusts flowing out of a storm can hit at gale force, well ahead of it."
  },
  {
   "i": 9,
   "start": 36.625,
   "speechStart": 36.625,
   "end": 42.8,
   "builds": 1,
   "text": "If you’re caught out, get everyone low, away from metal, the rods and the console, and out of the water."
  },
  {
   "i": 10,
   "start": 43.05,
   "speechStart": 43.05,
   "end": 44.8,
   "builds": 1,
   "text": "And waterspouts."
  },
  {
   "i": 11,
   "start": 45.05,
   "speechStart": 45.05,
   "end": 48.275,
   "builds": 0,
   "text": "They’re common in the Keys and along both coasts."
  },
  {
   "i": 12,
   "start": 48.525,
   "speechStart": 48.525,
   "end": 51.2,
   "builds": 0,
   "text": "Most are the weaker fair-weather kind."
  },
  {
   "i": 13,
   "start": 51.45,
   "speechStart": 51.45,
   "end": 54.025,
   "builds": 0,
   "text": "But how should you treat every one of them?"
  },
  {
   "i": 14,
   "start": 54.275,
   "speechStart": 55.025,
   "end": 56.75,
   "builds": 0,
   "text": "As dangerous."
  },
  {
   "i": 15,
   "start": 57.0,
   "speechStart": 57.0,
   "end": 59.875,
   "builds": 0,
   "text": "Move away at right angles to its path."
  }
 ]
}
