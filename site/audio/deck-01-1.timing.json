 "sentences": [
  {
   "i": 0,
   "start": 0.15,
   "speechStart": 0.15,
   "end": 2.9,
   "builds": 0,
   "text": "Welcome to Deck General and Safety."
  },
  {
   "i": 1,
   "start": 3.15,
   "speechStart": 3.15,
   "end": 6.7,
   "builds": 0,
   "text": "The Rules module was about not hitting anybody."
  },
  {
   "i": 2,
   "start": 6.95,
   "speechStart": 6.95,
   "end": 14.8,
   "builds": 0,
   "text": "This one is about everything else it takes to run a safe, legal charter, and it starts with the piece of paper you’re studying for."
  },
  {
   "i": 3,
   "start": 15.05,
   "speechStart": 15.05,
   "end": 18.575,
   "builds": 0,
   "text": "So what does a six-pack license actually let you do?"
  },
  {
   "i": 4,
   "start": 18.825,
   "speechStart": 18.825,
   "end": 22.025,
   "builds": 1,
   "text": "It lets you carry up to six passengers for hire."
  },
  {
   "i": 5,
   "start": 22.275,
   "speechStart": 22.275,
   "end": 24.6,
   "builds": 0,
   "text": "That’s where the nickname comes from."
  },
  {
   "i": 6,
   "start": 24.85,
   "speechStart": 24.85,
   "end": 27.6,
   "builds": 1,
   "text": "And only on an uninspected vessel."
  },
  {
   "i": 7,
   "start": 27.85,
   "speechStart": 27.85,
   "end": 30.825,
   "builds": 1,
   "text": "Where you can go depends on your endorsement."
  },
  {
   "i": 8,
   "start": 31.075,
   "speechStart": 31.075,
   "end": 34.8,
   "builds": 0,
   "text": "Near Coastal takes you up to one hundred miles offshore."
  },
  {
   "i": 9,
   "start": 35.05,
   "speechStart": 35.05,
   "end": 38.175,
   "builds": 0,
   "text": "Inland keeps you inside the boundary line."
  },
  {
   "i": 10,
   "start": 38.425,
   "speechStart": 38.425,
   "end": 44.05,
   "builds": 1,
   "text": "The credential is good for five years, and you renew it through the National Maritime Center."
  },
  {
   "i": 11,
   "start": 44.3,
   "speechStart": 44.3,
   "end": 45.925,
   "builds": 1,
   "text": "Now the limit."
  },
  {
   "i": 12,
   "start": 46.175,
   "speechStart": 46.175,
   "end": 49.55,
   "builds": 0,
   "text": "What if a seventh paying passenger wants to come along?"
  },
  {
   "i": 13,
   "start": 49.8,
   "speechStart": 50.55,
   "end": 52.35,
   "builds": 0,
   "text": "You can’t take him."
  },
  {
   "i": 14,
   "start": 52.6,
   "speechStart": 52.6,
   "end": 60.2,
   "builds": 0,
   "text": "Seven or more passengers for hire means an inspected vessel, with a Certificate of Inspection, and a Master license."
  },
  {
   "i": 15,
   "start": 60.45,
   "speechStart": 60.45,
   "end": 62.5,
   "builds": 0,
   "text": "Six is a hard number."
  }
 ]
}
