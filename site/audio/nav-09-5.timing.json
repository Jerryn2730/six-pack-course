   "speechStart": 0.15,
   "end": 4.5,
   "builds": 0,
   "text": "Let’s work that trap through, so you’ve done it once before the exam."
  },
  {
   "i": 1,
   "start": 4.75,
   "speechStart": 4.75,
   "end": 6.625,
   "builds": 0,
   "text": "Follow it on screen."
  },
  {
   "i": 2,
   "start": 6.875,
   "speechStart": 6.875,
   "end": 9.825,
   "builds": 1,
   "text": "You’re steering zero four five by compass."
  },
  {
   "i": 3,
   "start": 10.075,
   "speechStart": 10.075,
   "end": 14.125,
   "builds": 0,
   "text": "Your deviation card shows two degrees west on that heading."
  },
  {
   "i": 4,
   "start": 14.375,
   "speechStart": 14.375,
   "end": 17.1,
   "builds": 0,
   "text": "Variation is five degrees west."
  },
  {
   "i": 5,
   "start": 17.35,
   "speechStart": 17.35,
   "end": 21.775,
   "builds": 1,
   "text": "You take a bearing on a lighthouse, and the compass reads one two zero."
  },
  {
   "i": 6,
   "start": 22.025,
   "speechStart": 22.025,
   "end": 23.975,
   "builds": 1,
   "text": "Which deviation?"
  },
  {
   "i": 7,
   "start": 24.225,
   "speechStart": 24.225,
   "end": 27.05,
   "builds": 0,
   "text": "The one for zero four five, your heading."
  },
  {
   "i": 8,
   "start": 27.3,
   "speechStart": 27.3,
   "end": 28.825,
   "builds": 0,
   "text": "Two west."
  },
  {
   "i": 9,
   "start": 29.075,
   "speechStart": 29.075,
   "end": 33.35,
   "builds": 0,
   "text": "And we’re correcting, compass toward true, so west is subtracted."
  },
  {
   "i": 10,
   "start": 33.6,
   "speechStart": 33.6,
   "end": 37.625,
   "builds": 0,
   "text": "One two zero minus two is one one eight, magnetic."
  },
  {
   "i": 11,
   "start": 37.875,
   "speechStart": 37.875,
   "end": 40.4,
   "builds": 1,
   "text": "Now variation, five west."
  },
  {
   "i": 12,
   "start": 40.65,
   "speechStart": 40.65,
   "end": 42.375,
   "builds": 0,
   "text": "Subtract again."
  },
  {
   "i": 13,
   "start": 42.625,
   "speechStart": 42.625,
   "end": 46.15,
   "builds": 0,
   "text": "One one eight minus five is one one three, true."
  },
  {
   "i": 14,
   "start": 46.4,
   "speechStart": 46.4,
   "end": 48.375,
   "builds": 1,
   "text": "And what goes on the chart?"
  },
  {
   "i": 15,
   "start": 48.625,
   "speechStart": 49.375,
   "end": 51.125,
   "builds": 0,
   "text": "One one three."
  },
  {
   "i": 16,
   "start": 51.375,
   "speechStart": 51.375,
   "end": 53.925,
   "builds": 0,
   "text": "Bearings are always plotted as true."
  },
  {
   "i": 17,
   "start": 54.175,
   "speechStart": 54.175,
   "end": 56.05,
   "builds": 0,
   "text": "That’s lesson nine."
  },
  {
   "i": 18,
   "start": 56.3,
   "speechStart": 56.3,
   "end": 60.15,
   "builds": 0,
   "text": "True, variation, magnetic, deviation, compass."
  },
  {
   "i": 19,
   "start": 60.4,
   "speechStart": 60.4,
   "end": 62.375,
   "builds": 0,
   "text": "Correcting, add east."
  },
  {
   "i": 20,
   "start": 62.625,
   "speechStart": 62.625,
   "end": 65.225,
   "builds": 0,
   "text": "Deviation goes with your heading."
  },
  {
   "i": 21,
   "start": 65.475,
   "speechStart": 65.475,
   "end": 67.7,
   "builds": 0,
   "text": "Compass least, error east."
  },
  {
   "i": 22,
   "start": 67.95,
   "speechStart": 67.95,
   "end": 71.8,
   "builds": 0,
   "text": "Next time: headings, bearings and checking your compass."
