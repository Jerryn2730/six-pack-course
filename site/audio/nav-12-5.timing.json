 "sentences": [
  {
   "i": 0,
   "start": 0.15,
   "speechStart": 0.15,
   "end": 5.4,
   "builds": 0,
   "text": "Let’s tie radar back to the Rules, because the exam asks it from both sides."
  },
  {
   "i": 1,
   "start": 5.65,
   "speechStart": 5.65,
   "end": 13.125,
   "builds": 1,
   "text": "If your boat has radar, Rule seven says you must use it properly, including long-range scanning for early warning."
  },
  {
   "i": 2,
   "start": 13.375,
   "speechStart": 13.375,
   "end": 16.5,
   "builds": 0,
   "text": "Having it switched off in fog isn’t an option."
  },
  {
   "i": 3,
   "start": 16.75,
   "speechStart": 16.75,
   "end": 20.15,
   "builds": 1,
   "text": "A target seen only on radar is not in sight."
  },
  {
   "i": 4,
   "start": 20.4,
   "speechStart": 20.4,
   "end": 22.275,
   "builds": 0,
   "text": "That’s Rule three."
  },
  {
   "i": 5,
   "start": 22.525,
   "speechStart": 22.525,
   "end": 25.45,
   "builds": 1,
   "text": "So in fog, Rule nineteen governs."
  },
  {
   "i": 6,
   "start": 25.7,
   "speechStart": 25.7,
   "end": 28.975,
   "builds": 0,
   "text": "For a target forward of your beam, what don’t you do?"
  },
  {
   "i": 7,
   "start": 29.225,
   "speechStart": 29.975,
   "end": 31.65,
   "builds": 0,
   "text": "Turn to port."
  },
  {
   "i": 8,
   "start": 31.9,
   "speechStart": 31.9,
   "end": 33.975,
   "builds": 1,
   "text": "Help the other fellow, too."
  },
  {
   "i": 9,
   "start": 34.225,
   "speechStart": 34.225,
   "end": 39.675,
   "builds": 0,
   "text": "A radar reflector, mounted as high as practical, makes your boat a better target."
  },
  {
   "i": 10,
   "start": 39.925,
   "speechStart": 39.925,
   "end": 42.275,
   "builds": 1,
   "text": "And practice on clear days."
  },
  {
   "i": 11,
   "start": 42.525,
   "speechStart": 42.525,
   "end": 47.25,
   "builds": 0,
   "text": "Compare the screen with what your eyes see, until you can read it without thinking."
  },
  {
   "i": 12,
   "start": 47.5,
   "speechStart": 47.5,
   "end": 49.45,
   "builds": 0,
   "text": "That’s lesson twelve."
  },
  {
   "i": 13,
   "start": 49.7,
   "speechStart": 49.7,
   "end": 52.25,
   "builds": 0,
   "text": "Steady on the E B L means risk."
  },
  {
   "i": 14,
   "start": 52.5,
   "speechStart": 52.5,
   "end": 54.775,
   "builds": 0,
   "text": "Don’t tune out the real targets."
  },
  {
   "i": 15,
   "start": 55.025,
   "speechStart": 55.025,
   "end": 56.9,
   "builds": 0,
   "text": "Low beaches hide."
  },
  {
   "i": 16,
   "start": 57.15,
   "speechStart": 57.15,
   "end": 59.15,
   "builds": 0,
   "text": "Plot before you decide."
  },
  {
   "i": 17,
   "start": 59.4,
   "speechStart": 59.4,
   "end": 61.425,
   "builds": 0,
   "text": "Next time: weather."
  }
 ]
}
