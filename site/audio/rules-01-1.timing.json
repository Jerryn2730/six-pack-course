   "end": 1.9,
   "builds": 0,
   "text": "Welcome aboard."
  },
  {
   "i": 1,
   "start": 2.15,
   "speechStart": 2.15,
   "end": 3.9,
   "builds": 0,
   "text": "I’m glad you’re here."
  },
  {
   "i": 2,
   "start": 4.15,
   "speechStart": 4.15,
   "end": 13.425,
   "builds": 0,
   "text": "Over the next fifteen lessons, we’re going to work through the Navigation Rules together, the part of the captain’s exam that trips up more people than any other."
  },
  {
   "i": 3,
   "start": 13.675,
   "speechStart": 13.675,
   "end": 15.425,
   "builds": 1,
   "text": "Here’s why."
  },
  {
   "i": 4,
   "start": 15.675,
   "speechStart": 15.675,
   "end": 19.075,
   "builds": 0,
   "text": "Every other module needs seventy percent to pass."
  },
  {
   "i": 5,
   "start": 19.325,
   "speechStart": 19.325,
   "end": 21.275,
   "builds": 0,
   "text": "This one needs ninety."
  },
  {
   "i": 6,
   "start": 21.525,
   "speechStart": 21.525,
   "end": 25.225,
   "builds": 0,
   "text": "Out of fifty questions, you can miss only about five."
  },
  {
   "i": 7,
   "start": 25.475,
   "speechStart": 25.475,
   "end": 35.125,
   "builds": 2,
   "text": "So we’ll cover all thirty-seven rules, plus the annexes the exam pulls from, and after each lesson there’s a short check so you can make sure it stuck."
  },
  {
   "i": 8,
   "start": 35.375,
   "speechStart": 36.125,
   "end": 39.325,
   "builds": 0,
   "text": "Don’t worry about memorizing everything today."
  },
  {
   "i": 9,
   "start": 39.575,
   "speechStart": 39.575,
   "end": 42.625,
   "builds": 0,
   "text": "Just get comfortable with how the rules are built."
  },
  {
   "i": 10,
   "start": 42.875,
   "speechStart": 42.875,
   "end": 47.05,
   "builds": 0,
   "text": "The memorizing comes later, and I’ll give you plenty of tricks for it."
  }
 ]
