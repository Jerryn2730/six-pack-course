 "sentences": [
  {
   "i": 0,
   "start": 0.15,
   "speechStart": 0.15,
   "end": 5.925,
   "builds": 0,
   "text": "This is the last Deck lesson, and it’s about being a professional when something has gone wrong."
  },
  {
   "i": 1,
   "start": 6.175,
   "speechStart": 6.175,
   "end": 11.4,
   "builds": 0,
   "text": "As a commercial operator, you must report marine casualties to the Coast Guard."
  },
  {
   "i": 2,
   "start": 11.65,
   "speechStart": 11.65,
   "end": 13.3,
   "builds": 0,
   "text": "So what counts?"
  },
  {
   "i": 3,
   "start": 13.55,
   "speechStart": 13.55,
   "end": 16.925,
   "builds": 1,
   "text": "An unintended grounding, or striking a bridge."
  },
  {
   "i": 4,
   "start": 17.175,
   "speechStart": 17.175,
   "end": 22.825,
   "builds": 1,
   "text": "A loss of propulsion, steering or control that reduces your ability to maneuver."
  },
  {
   "i": 5,
   "start": 23.075,
   "speechStart": 23.075,
   "end": 27.05,
   "builds": 1,
   "text": "Anything that affects seaworthiness, like a fire or flooding."
  },
  {
   "i": 6,
   "start": 27.3,
   "speechStart": 27.3,
   "end": 32.8,
   "builds": 1,
   "text": "A death, or an injury that needs professional medical treatment beyond first aid."
  },
  {
   "i": 7,
   "start": 33.05,
   "speechStart": 33.05,
   "end": 39.225,
   "builds": 1,
   "text": "Property damage over seventy-five thousand dollars, or significant harm to the environment."
  },
  {
   "i": 8,
   "start": 39.475,
   "speechStart": 39.475,
   "end": 41.15,
   "builds": 0,
   "text": "So try this."
  },
  {
   "i": 9,
   "start": 41.4,
   "speechStart": 41.4,
   "end": 46.45,
   "builds": 0,
   "text": "You touch a sandbar on the way in, back off without damage, and nobody’s hurt."
  },
  {
   "i": 10,
   "start": 46.7,
   "speechStart": 46.7,
   "end": 48.625,
   "builds": 0,
   "text": "Do you have to report it?"
  },
  {
   "i": 11,
   "start": 48.875,
   "speechStart": 49.625,
   "end": 51.025,
   "builds": 0,
   "text": "Yes."
  },
  {
   "i": 12,
   "start": 51.275,
   "speechStart": 51.275,
   "end": 53.625,
   "builds": 0,
   "text": "It’s an unintended grounding."
  },
  {
   "i": 13,
   "start": 53.875,
   "speechStart": 53.875,
   "end": 56.45,
   "builds": 0,
   "text": "The rule doesn’t ask how hard you hit."
  },
  {
   "i": 14,
   "start": 56.7,
   "speechStart": 56.7,
   "end": 58.675,
   "builds": 0,
   "text": "When in doubt, report it."
  }
 ]
}
