 "voice": "af_heart",
 "speed": 0.97,
 "buildCount": 5,
 "sentences": [
  {
   "i": 0,
   "start": 0.15,
   "speechStart": 0.15,
   "end": 3.475,
   "builds": 0,
   "text": "Before you trust any chart, read its title block."
  },
  {
   "i": 1,
   "start": 3.725,
   "speechStart": 3.725,
   "end": 7.475,
   "builds": 0,
   "text": "It takes a minute, and it tells you what all the numbers mean."
  },
  {
   "i": 2,
   "start": 7.725,
   "speechStart": 7.725,
   "end": 10.525,
   "builds": 1,
   "text": "The chart number, the title and the scale."
  },
  {
   "i": 3,
   "start": 10.775,
   "speechStart": 10.775,
   "end": 14.575,
   "builds": 1,
   "text": "The units for soundings: feet, fathoms or meters."
  },
  {
   "i": 4,
   "start": 14.825,
   "speechStart": 14.825,
   "end": 19.775,
   "builds": 0,
   "text": "Get that one wrong and a six on the chart could be six feet, or thirty-six."
  },
  {
   "i": 5,
   "start": 20.025,
   "speechStart": 20.025,
   "end": 25.175,
   "builds": 0,
   "text": "And the depths are measured from a low-water level, usually mean lower low water."
  },
  {
   "i": 6,
   "start": 25.425,
   "speechStart": 25.425,
   "end": 30.85,
   "builds": 1,
   "text": "The horizontal datum, normally the North American Datum of nineteen eighty-three."
  },
  {
   "i": 7,
   "start": 31.1,
   "speechStart": 31.1,
   "end": 37.275,
   "builds": 0,
   "text": "For practical purposes it matches the WGS eighty-four datum in your GPS."
  },
  {
   "i": 8,
   "start": 37.525,
   "speechStart": 37.525,
   "end": 41.05,
   "builds": 0,
   "text": "If the two don’t match, your plotted position is off."
  },
  {
   "i": 9,
   "start": 41.3,
   "speechStart": 41.3,
   "end": 43.125,
   "builds": 1,
   "text": "Heights are different."
  },
  {
   "i": 10,
   "start": 43.375,
   "speechStart": 43.375,
   "end": 48.675,
   "builds": 0,
   "text": "Lights, landmarks and bridge clearances are measured above mean high water."
  },
  {
   "i": 11,
   "start": 48.925,
   "speechStart": 48.925,
   "end": 52.9,
   "builds": 0,
   "text": "Why would depths use low water and bridges use high water?"
  },
  {
   "i": 12,
   "start": 53.15,
   "speechStart": 53.9,
   "end": 56.0,
   "builds": 0,
   "text": "Both are the cautious choice."
  },
  {
   "i": 13,
   "start": 56.25,
   "speechStart": 56.25,
   "end": 58.15,
   "builds": 1,
   "text": "And the edition date."
  },
  {
   "i": 14,
   "start": 58.4,
   "speechStart": 58.4,
   "end": 60.35,
   "builds": 0,
   "text": "Keep the chart corrected."
  },
  {
   "i": 15,
   "start": 60.6,
   "speechStart": 60.6,
   "end": 62.425,
   "builds": 0,
   "text": "That’s lesson one."
  },
  {
   "i": 16,
   "start": 62.675,
   "speechStart": 62.675,
   "end": 64.525,
   "builds": 0,
   "text": "Latitude first."
  },
  {
   "i": 17,
   "start": 64.775,
   "speechStart": 64.775,
   "end": 67.15,
   "builds": 0,
   "text": "A minute of latitude is a mile."
  },
  {
   "i": 18,
   "start": 67.4,
   "speechStart": 67.4,
   "end": 69.85,
   "builds": 0,
   "text": "Large scale, large detail."
  },
  {
   "i": 19,
   "start": 70.1,
   "speechStart": 70.1,
   "end": 72.6,
   "builds": 0,
   "text": "Next time: reading the symbols."
  }
 ]
}
