 "sentences": [
  {
   "i": 0,
   "start": 0.15,
   "speechStart": 0.15,
   "end": 2.4,
   "builds": 0,
   "text": "Last, the waves themselves."
  },
  {
   "i": 1,
   "start": 2.65,
   "speechStart": 2.65,
   "end": 4.725,
   "builds": 1,
   "text": "Three things make them grow."
  },
  {
   "i": 2,
   "start": 4.975,
   "speechStart": 4.975,
   "end": 11.125,
   "builds": 0,
   "text": "Wind speed, fetch, and duration: how hard it blows, over how much water, and for how long."
  },
  {
   "i": 3,
   "start": 11.375,
   "speechStart": 11.375,
   "end": 15.575,
   "builds": 1,
   "text": "Fetch is the distance of open water the wind blows across."
  },
  {
   "i": 4,
   "start": 15.825,
   "speechStart": 15.825,
   "end": 18.725,
   "builds": 0,
   "text": "So picture a twenty-knot wind off the land."
  },
  {
   "i": 5,
   "start": 18.975,
   "speechStart": 18.975,
   "end": 21.625,
   "builds": 0,
   "text": "Near the beach, is it rough or smooth?"
  },
  {
   "i": 6,
   "start": 21.875,
   "speechStart": 22.625,
   "end": 24.1,
   "builds": 0,
   "text": "Smooth."
  },
  {
   "i": 7,
   "start": 24.35,
   "speechStart": 24.35,
   "end": 26.05,
   "builds": 0,
   "text": "There’s no fetch."
  },
  {
   "i": 8,
   "start": 26.3,
   "speechStart": 26.3,
   "end": 32.25,
   "builds": 0,
   "text": "Turn that same wind onshore, across a hundred miles of Gulf, and it builds real seas."
  },
  {
   "i": 9,
   "start": 32.5,
   "speechStart": 32.5,
   "end": 36.1,
   "builds": 1,
   "text": "Swell is waves that have left the place where they were made."
  },
  {
   "i": 10,
   "start": 36.35,
   "speechStart": 36.35,
   "end": 41.05,
   "builds": 0,
   "text": "It can arrive well ahead of a distant storm, on a perfectly calm day."
  },
  {
   "i": 11,
   "start": 41.3,
   "speechStart": 41.3,
   "end": 47.3,
   "builds": 1,
   "text": "Forecast wave heights are significant wave heights: the average of the highest third of the waves."
  },
  {
   "i": 12,
   "start": 47.55,
   "speechStart": 47.55,
   "end": 51.675,
   "builds": 1,
   "text": "So expect some waves much larger, now and then about double."
  },
  {
   "i": 13,
   "start": 51.925,
   "speechStart": 51.925,
   "end": 55.825,
   "builds": 0,
   "text": "A four-foot forecast includes the occasional eight-footer."
  },
  {
   "i": 14,
   "start": 56.075,
   "speechStart": 56.075,
   "end": 58.65,
   "builds": 0,
   "text": "That completes Navigation General."
  },
  {
   "i": 15,
   "start": 58.9,
   "speechStart": 58.9,
   "end": 62.8,
   "builds": 0,
   "text": "Next comes chart plotting, where we put all of this on paper."
  }
 ]
}
