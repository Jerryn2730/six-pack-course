{
 "slide": "nav-11-4",
 "lessonId": "nav-11",
 "n": 4,
 "audio": "nav-11-4.mp3",
 "duration": 53.9,
 "voice": "af_heart",
 "speed": 0.97,
 "buildCount": 5,
 "sentences": [
  {
   "i": 0,
   "start": 0.15,
   "speechStart": 0.15,
   "end": 6.475,
   "builds": 0,
   "text": "The humblest instrument on the dash is one of the best navigation checks you have: the depth sounder."
  },
  {
   "i": 1,
   "start": 6.725,
   "speechStart": 6.725,
   "end": 10.3,
   "builds": 0,
   "text": "It sends a pulse of sound down, and times the echo."
  },
  {
   "i": 2,
   "start": 10.55,
   "speechStart": 10.55,
   "end": 13.325,
   "builds": 1,
   "text": "It shows the depth below the transducer."
  },
  {
   "i": 3,
   "start": 13.575,
   "speechStart": 13.575,
   "end": 16.725,
   "builds": 0,
   "text": "Not below the keel, and not from the surface."
  },
  {
   "i": 4,
   "start": 16.975,
   "speechStart": 16.975,
   "end": 19.125,
   "builds": 1,
   "text": "Unless you’ve set an offset."
  },
  {
   "i": 5,
   "start": 19.375,
   "speechStart": 19.375,
   "end": 21.6,
   "builds": 0,
   "text": "So do you know how yours is set?"
  },
  {
   "i": 6,
   "start": 21.85,
   "speechStart": 22.6,
   "end": 24.1,
   "builds": 0,
   "text": "Find out."
  },
  {
   "i": 7,
   "start": 24.35,
   "speechStart": 24.35,
   "end": 28.55,
   "builds": 0,
   "text": "Two feet of difference matters a great deal on a Florida flat."
  },
  {
   "i": 8,
   "start": 28.8,
   "speechStart": 28.8,
   "end": 30.825,
   "builds": 1,
   "text": "Now use it to navigate."
  },
  {
   "i": 9,
   "start": 31.075,
   "speechStart": 31.075,
   "end": 35.175,
   "builds": 0,
   "text": "Compare what it reads with the charted depth plus the height of tide."
  },
  {
   "i": 10,
   "start": 35.425,
   "speechStart": 35.425,
   "end": 38.675,
   "builds": 0,
   "text": "If they agree, you’re probably where you think you are."
  },
  {
   "i": 11,
   "start": 38.925,
   "speechStart": 38.925,
   "end": 41.65,
   "builds": 0,
   "text": "If they don’t, stop and find out why."
  },
  {
   "i": 12,
   "start": 41.9,
   "speechStart": 41.9,
   "end": 47.8,
   "builds": 1,
   "text": "In poor visibility, you can follow a depth contour toward a harbor, like following a handrail."
  },
  {
   "i": 13,
   "start": 48.05,
   "speechStart": 48.05,
   "end": 50.35,
   "builds": 1,
   "text": "And set the shallow-water alarm."
  },
  {
   "i": 14,
   "start": 50.6,
   "speechStart": 50.6,
   "end": 53.6,
   "builds": 0,
   "text": "In our skinny water, it’s cheap insurance."
  }
 ]
}
