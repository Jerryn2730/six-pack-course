   "end": 5.0,
   "builds": 0,
   "text": "A deviation table is your compass’s report card, heading by heading."
  },
  {
   "i": 1,
   "start": 5.25,
   "speechStart": 5.25,
   "end": 7.45,
   "builds": 0,
   "text": "Look at this one as it builds."
  },
  {
   "i": 2,
   "start": 7.7,
   "speechStart": 7.7,
   "end": 10.725,
   "builds": 1,
   "text": "On zero zero zero, two degrees east."
  },
  {
   "i": 3,
   "start": 10.975,
   "speechStart": 10.975,
   "end": 13.525,
   "builds": 1,
   "text": "On zero three zero, one east."
  },
  {
   "i": 4,
   "start": 13.775,
   "speechStart": 13.775,
   "end": 16.0,
   "builds": 1,
   "text": "On zero six zero, none."
  },
  {
   "i": 5,
   "start": 16.25,
   "speechStart": 16.25,
   "end": 18.9,
   "builds": 1,
   "text": "On zero nine zero, two west."
  },
  {
   "i": 6,
   "start": 19.15,
   "speechStart": 19.15,
   "end": 21.65,
   "builds": 1,
   "text": "On one two zero, three west."
  },
  {
   "i": 7,
   "start": 21.9,
   "speechStart": 21.9,
   "end": 24.5,
   "builds": 1,
   "text": "And on one five zero, two west."
  },
  {
   "i": 8,
   "start": 24.75,
   "speechStart": 24.75,
   "end": 27.725,
   "builds": 0,
   "text": "See how it swings smoothly from east to west?"
  },
  {
   "i": 9,
   "start": 27.975,
   "speechStart": 27.975,
   "end": 29.6,
   "builds": 0,
   "text": "That’s normal."
  },
  {
   "i": 10,
   "start": 29.85,
   "speechStart": 29.85,
   "end": 33.225,
   "builds": 0,
   "text": "Now, what if your heading falls between two lines?"
  },
  {
   "i": 11,
   "start": 33.475,
   "speechStart": 33.475,
   "end": 35.25,
   "builds": 0,
   "text": "You interpolate."
  },
  {
   "i": 12,
   "start": 35.5,
   "speechStart": 35.5,
   "end": 38.775,
   "builds": 0,
   "text": "Say you’re steering zero seven five magnetic."
  },
  {
   "i": 13,
   "start": 39.025,
   "speechStart": 39.025,
   "end": 45.5,
   "builds": 0,
   "text": "That’s halfway between zero six zero, with no deviation, and zero nine zero, with two west."
  },
  {
   "i": 14,
   "start": 45.75,
   "speechStart": 45.75,
   "end": 47.825,
   "builds": 0,
   "text": "So what’s the deviation?"
  },
  {
   "i": 15,
   "start": 48.075,
   "speechStart": 48.825,
   "end": 50.75,
   "builds": 0,
   "text": "About one degree west."
  },
  {
   "i": 16,
   "start": 51.0,
   "speechStart": 51.0,
   "end": 52.7,
   "builds": 0,
   "text": "One caution."
  },
  {
   "i": 17,
   "start": 52.95,
   "speechStart": 52.95,
   "end": 58.1,
   "builds": 0,
   "text": "Some tables are entered with the compass heading, and some with the magnetic heading."
