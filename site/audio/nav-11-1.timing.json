{
 "slide": "nav-11-1",
 "lessonId": "nav-11",
 "n": 1,
 "audio": "nav-11-1.mp3",
 "duration": 69.325,
 "voice": "af_heart",
 "speed": 0.97,
 "buildCount": 5,
 "sentences": [
  {
   "i": 0,
   "start": 0.15,
   "speechStart": 0.15,
   "end": 4.85,
   "builds": 0,
   "text": "Your grandfather navigated with a compass, a watch and a lead line."
  },
  {
   "i": 1,
   "start": 5.1,
   "speechStart": 5.1,
   "end": 8.275,
   "builds": 0,
   "text": "You have a screen that shows a little boat on a chart."
  },
  {
   "i": 2,
   "start": 8.525,
   "speechStart": 8.525,
   "end": 12.475,
   "builds": 0,
   "text": "That’s a wonderful thing, right up to the moment it goes blank."
  },
  {
   "i": 3,
   "start": 12.725,
   "speechStart": 12.725,
   "end": 17.975,
   "builds": 0,
   "text": "So today we learn what the electronics really tell you, and where each one can fool you."
  },
  {
   "i": 4,
   "start": 18.225,
   "speechStart": 18.225,
   "end": 20.125,
   "builds": 0,
   "text": "Start with GPS."
  },
  {
   "i": 5,
   "start": 20.375,
   "speechStart": 20.375,
   "end": 25.375,
   "builds": 1,
   "text": "It fixes your position from satellite signals, typically within a few meters."
  },
  {
   "i": 6,
   "start": 25.625,
   "speechStart": 25.625,
   "end": 32.1,
   "builds": 1,
   "text": "A correction system called WAAS, available across North America, makes it better still."
  },
  {
   "i": 7,
   "start": 32.35,
   "speechStart": 32.35,
   "end": 36.275,
   "builds": 1,
   "text": "It also gives you speed over ground and course over ground."
  },
  {
   "i": 8,
   "start": 36.525,
   "speechStart": 36.525,
   "end": 38.325,
   "builds": 0,
   "text": "Where do those come from?"
  },
  {
   "i": 9,
   "start": 38.575,
   "speechStart": 39.325,
   "end": 41.7,
   "builds": 0,
   "text": "From how your position changes."
  },
  {
   "i": 10,
   "start": 41.95,
   "speechStart": 41.95,
   "end": 43.8,
   "builds": 0,
   "text": "Not from the compass."
  },
  {
   "i": 11,
   "start": 44.05,
   "speechStart": 44.05,
   "end": 48.275,
   "builds": 0,
   "text": "So sitting still at the dock, your GPS heading means nothing."
  },
  {
   "i": 12,
   "start": 48.525,
   "speechStart": 48.525,
   "end": 56.475,
   "builds": 1,
   "text": "Set the receiver’s datum to match your chart: WGS eighty-four, which matches the North American Datum on the chart."
  },
  {
   "i": 13,
   "start": 56.725,
   "speechStart": 56.725,
   "end": 60.35,
   "builds": 1,
   "text": "And GPS can fail, lose power, or be jammed."
  },
  {
   "i": 14,
   "start": 60.6,
   "speechStart": 60.6,
   "end": 64.125,
   "builds": 0,
   "text": "The old Loran backup was shut down in twenty ten."
  },
  {
   "i": 15,
   "start": 64.375,
   "speechStart": 64.375,
   "end": 69.025,
   "builds": 0,
   "text": "Your backup now is you: dead reckoning, a paper chart and a compass."
  }
 ]
}
